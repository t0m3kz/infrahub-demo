{#- Zscaler ZPA — application segment tfvars shape for a companion Terraform module
    (zpa_application_segment-style). Verify field names against the zscaler/zpa
    Terraform provider docs before real use. -#}
{
  "proxy_name": {{ name | tojson }},
  "provider": {{ provider | tojson }},
  "deployment_model": {{ deployment_model | tojson }},
  "zpa_application_segments": [
{%- for seg in segments %}
    {
      "name": {{ seg.name | tojson }},
      "domain_names": [{{ seg.fqdn | tojson }}],
      "tcp_port_ranges": [{% for p in seg.ports %}{{ (p.port | string) | tojson }}, {{ ((p.port_end or p.port) | string) | tojson }}{{ ", " if not loop.last }}{% endfor %}],
      "allowed_groups": {{ seg.allowed_groups | tojson }}
    }{{ "," if not loop.last }}
{%- endfor %}
  ]
}
