{%- set _lb = namespace(name='loopback0') -%}
{%- for iface in interfaces -%}
{%- if iface.name | lower | truncate(8, true, '') == 'loopback' and _lb.name == 'loopback0' -%}
{%- set _lb.name = iface.name -%}
{%- endif -%}
{%- endfor -%}
!
! {{ name }} Configuration
!
hostname {{ name }}
!
feature ospf
feature bgp
feature interface-vlan
feature lacp
feature vpc
feature lldp
!
{%- if vlans and vlans|length > 0 %}
! VLANs
{%- for vlan in vlans %}
vlan {{ vlan.vlan_id }}
  name {{ vlan.name }}
!
{%- endfor %}
{%- endif %}
!
! Interfaces
{%- for interface in interfaces %}
interface {{ interface.name }}
{%- if interface.dot1q_vlan %}
  encapsulation dot1q {{ interface.dot1q_vlan }}
{%- endif %}
{%- if interface.status == 'active' %}
  no shutdown
{%- endif %}
{%- include 'common/cisco_nxos_interface_ip.j2' %}
{%- if interface.vlans and interface.vlans|length > 0 %}
  switchport
  switchport mode access
  switchport access vlan {{ interface.vlans[0] }}
{%- endif %}
{%- if interface.get('ospf') %}
  ip ospf area {{ interface.ospf.area }}
{%- endif %}
!
{%- endfor %}
!
{%- if ospf and ospf|length > 0 %}
! OSPF Configuration
{% include 'common/cisco_nxos_ospf.j2' %}
{%- endif %}
!
{%- if bgp and bgp|length > 0 %}
! BGP Configuration
{% include 'common/cisco_nxos_bgp.j2' %}
{%- endif %}
!
{#- Only a colocation edge acting as its site's EVPN Multi-Site border
    gateway has a vxlan block (transforms/config/edge.py). #}
{%- include 'common/cisco_nxos_vxlan.j2' %}
{#- A BGW also routes its site's stretched segments: same anycast gateway
    (IP and MAC) as the DC leaves, so a host keeps its gateway wherever the
    segment reaches, and the SVI's VRF is the handoff VRF towards the office. #}
{%- if vxlan and vxlan.anycast_gateway and vxlan.anycast_gateway.enabled %}
!
{%- if not (vxlan.enabled and 'fabric forwarding' in (vxlan.features or [])) %}
feature fabric forwarding
{%- endif %}
fabric forwarding anycast-gateway-mac {{ vxlan.anycast_gateway.mac | replace(':', '') | replace('.', '') }}
{%- for vlan in vlans if vlan.gateway_ip or vlan.gateway_ipv6 %}
!
interface Vlan{{ vlan.vlan_id }}
  description {{ vlan.name }}
{%- if vlan.vrf %}
  vrf member {{ vlan.vrf }}
{%- endif %}
{%- if vlan.gateway_ip %}
  ip address {{ vlan.gateway_ip }}
{%- endif %}
{%- if vlan.gateway_ipv6 %}
  ipv6 address {{ vlan.gateway_ipv6 }}
{%- endif %}
  fabric forwarding mode anycast-gateway
  no shutdown
{%- endfor %}
{%- endif %}
{%- if bgp and bgp|length > 0 %}
!
! Route-maps
{#- Referenced by cisco_nxos_bgp.j2's `redistribute direct`; an undefined
    route-map redistributes nothing. A BGW also advertises its VTEP and
    site-VIP loopbacks so the remote site can reach the tunnel endpoints. #}
route-map RM-CONN-2-BGP permit 10
  match interface {{ ([_lb.name] + (vxlan.multisite.advertise_interfaces if vxlan and vxlan.multisite else [])) | unique | join(' ') }}
!
{%- if vxlan and vxlan.l3_vni_mappings %}
route-map RM-VRF-DIRECT-2-EVPN permit 10
!
{%- endif %}
{%- endif %}
{%- include 'common/cisco_nxos_management.j2' %}
!
! Management
line console
line vty
!
