!
! {{ name }} Configuration
!
hostname {{ name }}
!
feature ospf
feature bgp
{%- include 'common/cisco_nxos_feature_bfd.j2' %}
feature interface-vlan
feature lacp
feature vpc
feature lldp
{%- include 'common/cisco_nxos_feature_evpn.j2' %}
!
{%- if vlans and vlans|length > 0 %}
! VLANs
{%- for vlan in vlans %}
vlan {{ vlan.vlan_id }}
  name {{ vlan.name }}
!
{%- endfor %}
{%- endif %}
{#- A VRF instance without an L3 VNI is VRF-lite: it gets a plain stanza here (NX-OS needs the `vrf context`
    before `vrf member` can reference it). INTERNET on a border-gateway edge has an L3 VNI, so the shared VXLAN VRF
    partial (cisco_nxos_vxlan_vrf.j2) declares it instead: vni, RD/RT, `advertise l2vpn evpn`. -#}
{%- if plain_vrfs %}
!
! VRF Contexts (BGP handoffs without an L3 VNI)
{%- for vrf_name in plain_vrfs %}
vrf context {{ vrf_name }}
  address-family ipv4 unicast
!
{%- endfor %}
{%- endif %}
!
! Interfaces
{%- include 'common/cisco_nxos_subif_parents.j2' %}
{%- for interface in interfaces %}
interface {{ interface.name }}
{%- include 'common/cisco_nxos_routed_port.j2' %}
{%- if interface.dot1q_vlan %}
  encapsulation dot1q {{ interface.dot1q_vlan }}
{%- endif %}
{%- if interface.status == 'active' %}
  no shutdown
{%- endif %}
{%- include 'common/cisco_nxos_interface_ip.j2' %}
{%- include 'common/cisco_nxos_switchport.j2' %}
{%- if interface.get('ospf') %}
  ip ospf area {{ interface.ospf.area }}
{%- endif %}
!
{%- endfor %}
!
{%- if bgp and bgp|length > 0 %}
{%- include 'common/cisco_nxos_route_maps.j2' %}
{%- include 'common/cisco_nxos_vrf_static.j2' %}
{#- Upstream transit sessions (session.transit, bgp.py): accept the default
    route only; announce only the INTERNET namespace's public prefixes
    (internet_prefixes: the aggregate and the SNAT space), nothing when none is
    known. -#}
{%- set _transit = namespace(on=false) %}
{%- for bgp_config in bgp %}
{%- for sessions in (bgp_config.vrf_sessions or {}).values() %}
{%- for session in sessions if session.get('transit') %}{% set _transit.on = true %}{% endfor %}
{%- endfor %}
{%- endfor %}
{%- if _transit.on %}
ip prefix-list PL-TRANSIT-IN-DEFAULT seq 10 permit 0.0.0.0/0
route-map RM-TRANSIT-IN permit 10
  match ip address prefix-list PL-TRANSIT-IN-DEFAULT
!
{%- for prefix in internet_prefixes | default([]) %}
ip prefix-list PL-TRANSIT-OUT-PUBLIC seq {{ loop.index * 10 }} permit {{ prefix }}
{%- endfor %}
{%- if internet_prefixes | default([]) %}
route-map RM-TRANSIT-OUT permit 10
  match ip address prefix-list PL-TRANSIT-OUT-PUBLIC
route-map RM-TRANSIT-OUT deny 20
{%- else %}
route-map RM-TRANSIT-OUT deny 10
{%- endif %}
!
{%- endif %}
{#- External peers in a tenant VRF (session.external, bgp.py): a cloud VIF or
    the SD-WAN gateway, outside our administration. Per session
    (external_policies, by handoff sub-interface): the owners are the customers
    that registered the prefixes behind it. In: exactly those registered
    prefixes, never a default. Out: only the on-prem prefixes of those same
    owners, never another customer's. Exact prefixes, no le/ge. A session with
    no registered customer owner accepts nothing and announces nothing
    (deny-all both ways). Evidence I: inferred, not lab-verified. -#}
{#- Routing identity (utils/routing_identity.py), when any customer or segment carries a tag (policy.identity): a tag
    is visibility, never the filter, so the prefix-lists below stay the gate. In: our two community ranges are
    deleted from whatever the far end sends (it cannot forge an identity), then the community of the owner that
    registered the accepted prefix is added; one sequence per owner, so a session with several owners tags each
    prefix with its own. Out: our communities are deleted before the route leaves our administration.
    Evidence I: inferred, not lab-verified. UNVERIFIED: the unquoted expanded-list expression and that
    `set comm-list <list> delete` is applied before `set community ... additive` within one sequence.
    Cisco Nexus 9000 Unicast Routing guide: `ip community-list expanded`, `set comm-list <list> delete`,
    `set community <aa:nn> additive`. #}
{%- set _identity = (external_policies | default({})).values() | selectattr('identity', 'defined') | selectattr('identity') | list %}
{%- if _identity %}
{%- for regex in routing_community_regexes %}
ip community-list expanded CL-ROUTING-IDENTITY permit {{ regex }}
{%- endfor %}
!
{%- endif %}
{%- for bgp_config in bgp %}
{%- for sessions in (bgp_config.vrf_sessions or {}).values() %}
{%- for session in sessions if session.get('external') %}
{%- set _policy = (external_policies | default({})).get(session.local_interface, {}) %}
{%- set _owners = _policy.get('owners', []) %}
{%- set _in = _policy.get('in', []) %}
{%- set _out = _policy.get('out', []) %}
{%- if _owners %}
! {{ session.name }}: owners {{ _owners | join(', ') }}
{%- else %}
! {{ session.name }}: no registered customer owner, announces nothing and accepts nothing
{%- endif %}
{%- if _policy.get('identity') %}
{%- for owner in _policy.in_owners %}
{%- set _owner_seq = loop.index * 10 %}
{%- for prefix in owner.prefixes %}
ip prefix-list PL-{{ session.name }}-IN-{{ owner.name }} seq {{ loop.index * 10 }} permit {{ prefix }}
{%- endfor %}
route-map RM-{{ session.name }}-IN permit {{ _owner_seq }}
  match ip address prefix-list PL-{{ session.name }}-IN-{{ owner.name }}
  set comm-list CL-ROUTING-IDENTITY delete
{%- if owner.community %}
  set community {{ owner.community }} additive
{%- endif %}
{%- else %}
route-map RM-{{ session.name }}-IN deny 10
{%- endfor %}
{%- else %}
{%- for prefix in _in %}
ip prefix-list PL-{{ session.name }}-IN seq {{ loop.index * 10 }} permit {{ prefix }}
{%- endfor %}
{%- if _in %}
route-map RM-{{ session.name }}-IN permit 10
  match ip address prefix-list PL-{{ session.name }}-IN
{%- else %}
route-map RM-{{ session.name }}-IN deny 10
{%- endif %}
{%- endif %}
{%- for prefix in _out %}
ip prefix-list PL-{{ session.name }}-OUT seq {{ loop.index * 10 }} permit {{ prefix }}
{%- endfor %}
{%- if _out %}
route-map RM-{{ session.name }}-OUT permit 10
  match ip address prefix-list PL-{{ session.name }}-OUT
{%- if _policy.get('identity') %}
  set comm-list CL-ROUTING-IDENTITY delete
{%- endif %}
route-map RM-{{ session.name }}-OUT deny 20
{%- else %}
route-map RM-{{ session.name }}-OUT deny 10
{%- endif %}
!
{%- endfor %}
{%- endfor %}
{%- endfor %}
{%- endif %}

{%- if ospf and ospf|length > 0 %}
! OSPF Configuration
{% include 'common/cisco_nxos_ospf.j2' %}
{%- endif %}
!
{%- if bgp and bgp|length > 0 %}
! BGP Configuration
{% include 'common/cisco_nxos_bgp.j2' %}
{%- endif %}
!
{#- Only a colocation edge acting as its site's EVPN Multi-Site border
    gateway has a vxlan block (transforms/config/edge.py). #}
{%- include 'common/cisco_nxos_vxlan.j2' %}
{#- A BGW also routes its site's stretched segments: same anycast gateway
    (IP and MAC) as the DC leaves, so a host keeps its gateway wherever the
    segment reaches, and the SVI's VRF is the handoff VRF towards the office. #}
{%- if vxlan and vxlan.anycast_gateway and vxlan.anycast_gateway.enabled %}
!
fabric forwarding anycast-gateway-mac {{ vxlan.anycast_gateway.mac | replace(':', '') | replace('.', '') }}
{%- for vlan in vlans if vlan.gateway_ip or vlan.gateway_ipv6 %}
!
interface Vlan{{ vlan.vlan_id }}
  description {{ vlan.description }}
{%- if vlan.vrf %}
  vrf member {{ vlan.vrf }}
{%- endif %}
{%- if vlan.gateway_ip %}
  ip address {{ vlan.gateway_ip }}
{%- endif %}
{%- if vlan.gateway_ipv6 %}
  ipv6 address {{ vlan.gateway_ipv6 }}
{%- endif %}
  fabric forwarding mode anycast-gateway
  no shutdown
{%- endfor %}
{%- endif %}

!
! Management
line console
line vty
!
