!
! {{ name }} Configuration
!
hostname {{ name }}
!
{%- if edge_feature_lines | default(true) %}
feature ospf
feature bgp
feature interface-vlan
feature lacp
feature vpc
feature lldp
!
{%- endif %}
{%- if vlans and vlans|length > 0 %}
! VLANs
{%- for vlan in vlans %}
vlan {{ vlan.vlan_id }}
  name {{ vlan.name }}
!
{%- endfor %}
{%- endif %}
!
! Interfaces
{%- for interface in interfaces %}
interface {{ interface.name }}
{%- if interface.display_description %}
  description {{ interface.display_description }}
{%- endif %}
{%- if interface.status == 'active' %}
  no shutdown
{%- endif %}
{%- include 'common/cisco_nxos_interface_ip.j2' %}
{%- if interface.vlans and interface.vlans|length > 0 %}
{%- include 'common/cisco_nxos_switchport.j2' %}
{%- endif %}
{%- if interface.get('ospf') %}
  ip ospf area {{ interface.ospf.area }}
{%- endif %}
!
{%- endfor %}
!
{%- if ospf and ospf|length > 0 %}
! OSPF Configuration
{% include 'common/cisco_nxos_ospf.j2' %}
{%- endif %}
!
{%- if bgp and bgp|length > 0 %}
! BGP Configuration
{% include 'common/cisco_ios_bgp.j2' %}
{%- endif %}
!
! Route-maps
route-map RM-CONN-2-BGP permit 10
  match interface Loopback0
!

!
! Management
line console
line vty
!
