{#- Sonic JSON Border Leaf Configuration - Using Jinja2 tojson filter for clean JSON -#}
{%- set device_metadata = {
  'localhost': {
    'hostname': hostname,
    'type': 'BorderLeafRouter'
  }
} -%}
{%- if bgp %}
{%- set _ = device_metadata['localhost'].update({'bgp_asn': bgp[0].local_as.asn}) -%}
{%- endif %}

{%- set vlan_config = {} -%}
{%- set loopback_interfaces = {} -%}
{%- set physical_interfaces = {} -%}
{%- set interface_ips = {} -%}
{%- set vlan_interfaces = {} -%}
{%- set bgp_neighbors = {} -%}
{%- set bgp_globals = {'default': {}} -%}
{%- set bgp_peer_groups = {} -%}
{%- set bgp_globals_af = {} -%}
{%- set ospf_router = {} -%}
{%- include 'common/sonic_common.j2' %}

{%- set vxlan_tunnel = {} -%}
{%- set vxlan_tunnel_map = {} -%}
{%- set vrf_config = {} -%}
{%- set vrf_loopback_interfaces = {} -%}
{%- set evpn_nvo = {} -%}
{%- include 'common/sonic_vxlan.j2' %}

{%- set static_route_table = {} -%}
{%- if vrf_gateways %}
{%- for vrf, nexthop in vrf_gateways.items() %}
{%- set _ = static_route_table.update({vrf + '|0.0.0.0/0': {'nexthop': nexthop, 'ifname': '', 'nexthop-vrf': ''}}) -%}
{%- endfor %}
{%- endif %}

{{ {
  'DEVICE_METADATA': device_metadata,
  'VLAN': vlan_config,
  'LOOPBACK_INTERFACE': loopback_interfaces,
  'INTERFACE': physical_interfaces,
  'INTERFACE_IP': interface_ips,
  'VLAN_INTERFACE': vlan_interfaces,
  'BGP_GLOBALS': bgp_globals,
  'BGP_GLOBALS_AF': bgp_globals_af,
  'BGP_PEER_GROUP': bgp_peer_groups,
  'BGP_NEIGHBOR': bgp_neighbors,
  'OSPF_ROUTER': ospf_router,
  'VXLAN_TUNNEL': vxlan_tunnel,
  'VXLAN_TUNNEL_MAP': vxlan_tunnel_map,
  'VRF': vrf_config,
  'EVPN_NVO': evpn_nvo,
  'STATIC_ROUTE': static_route_table
} | tojson(indent=2) }}
{%- include 'common/sonic_mclag.j2' -%}
{%- include 'common/sonic_management.j2' %}
{%- if border_leaf_pbr_rules %}
!
! Border-leaf PBR (.dev/scenariusze.txt "SONiC-BORDER-LEAF") — default-
! redirect every segment's traffic to its firewall context's nexthop.
! SONiC has no hardware SGT/security-group primitive, so every rule here
! matches by source prefix (same as scenariusze.txt's own SONiC section).
! FRR CLI text, same convention as common/dell_sonic_bgp.j2/dell_sonic_ospf.j2
! — SONiC's control plane is FRR underneath, and route-map-based PBR is
! applied the same way ConfigDB doesn't model policy-routing directly.
!
{%- for rule in border_leaf_pbr_rules %}
! Customer: {{ rule.customer_name or 'any' }}/{{ rule.environment or 'any' }}
ip access-list {{ rule.acl_name }}
{%- for prefix in rule.source_prefixes %}
  seq {{ loop.index * 10 }} permit ip {{ prefix }} any
{%- endfor %}
!
route-map RM-BORDER-LEAF-PBR permit {{ loop.index * 10 }}
  match ip address {{ rule.acl_name }}
  set ip next-hop {{ rule.fw_nexthop }}
!
{%- endfor %}
! Applied on every uplink (fabric-facing) interface — that's where traffic
! from any leaf in this DC arrives at the border-leaf.
{%- for interface in interfaces if interface.role == 'uplink' %}
interface {{ interface.name }}
  ip policy route-map RM-BORDER-LEAF-PBR
!
{%- endfor %}
{%- endif %}
