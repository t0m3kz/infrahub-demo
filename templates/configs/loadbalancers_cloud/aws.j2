{#- Representative Terraform HCL for an AWS Application/Network Load Balancer — verify
    resource arguments against the aws Terraform provider docs before real use. -#}
{% for name in dns_names -%}
# endpoint: {{ name }}
{% endfor -%}
resource "aws_lb" "{{ lb_name | tf_id }}" {
  name               = "{{ lb_name }}"
  load_balancer_type = "{{ lb_type }}"
  internal           = {{ internal | lower }}
  subnets            = [{% for s in subnet_names %}"{{ s }}"{{ ", " if not loop.last }}{% endfor %}]

  tags = {
{%- for key, value in (tags or {}).items() %}
    {{ key }} = "{{ value }}"
{%- endfor %}
  }
}
{% for pool in backend_pools %}
resource "aws_lb_target_group" "{{ pool.name | tf_id }}" {
  name        = "{{ pool.name }}"
  port        = {{ pool.port }}
  protocol    = "{{ pool.protocol }}"
  target_type = "{{ pool.target_type }}"
  vpc_id      = data.aws_vpc.{{ vpc_name | tf_id }}.id
{%- if pool.health_check %}

  health_check {
    protocol            = "{{ pool.health_check.protocol | upper }}"
{%- if pool.health_check.path %}
    path                = "{{ pool.health_check.path }}"
{%- endif %}
{%- if pool.health_check.matcher %}
    matcher             = "{{ pool.health_check.matcher }}"
{%- endif %}
    interval            = {{ pool.health_check.interval }}
{%- if layer == 'l7' %}
    timeout             = {{ pool.health_check.timeout }}
{%- endif %}
    healthy_threshold   = {{ pool.health_check.healthy_threshold }}
    unhealthy_threshold = {{ pool.health_check.unhealthy_threshold }}
  }
{%- endif %}
}
{%- for target in pool.targets %}

resource "aws_lb_target_group_attachment" "{{ pool.name | tf_id }}_{{ target | tf_id }}" {
  target_group_arn = aws_lb_target_group.{{ pool.name | tf_id }}.arn
  target_id        = "{{ target }}"
  port             = {{ pool.port }}
}
{%- endfor %}

{% endfor %}
{% for listener in listeners %}
resource "aws_lb_listener" "{{ (listener.hostname ~ '-' ~ listener.protocol ~ '-' ~ listener.port) | tf_id }}" {
  load_balancer_arn = aws_lb.{{ lb_name | tf_id }}.arn
  port              = {{ listener.port }}
  protocol          = "{{ listener.protocol | upper }}"
{%- if listener.certificate_arn %}
  certificate_arn   = "{{ listener.certificate_arn }}"
{%- endif %}
{%- if listener.ssl_policy %}
  ssl_policy        = "{{ listener.ssl_policy }}"
{%- endif %}

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.{{ (listener.hostname ~ '-' ~ listener.protocol ~ '-' ~ listener.port) | tf_id }}.arn
  }
}
{% endfor -%}
