{#- Representative Terraform HCL for a GCP load balancer — verify resource arguments
    against the google Terraform provider docs before real use. -#}
{% for name in dns_names -%}
# endpoint: {{ name }}
{% endfor -%}
locals {
  {{ lb_name | tf_id }}_labels = {
{%- for key, value in (labels or {}).items() %}
    {{ key }} = "{{ value }}"
{%- endfor %}
  }
}
{% for hc in health_checks %}
resource "google_compute_health_check" "{{ hc.name | tf_id }}" {
  name = "{{ hc.name }}"
{%- if hc.protocol in ('HTTP', 'HTTPS', 'TCP', 'SSL') %}

  {{ hc.protocol | lower }}_health_check {
    port = {{ hc.port }}
{%- if hc.request_path %}
    request_path = "{{ hc.request_path }}"
{%- endif %}
  }
{%- endif %}

  check_interval_sec  = {{ hc.check_interval_sec }}
  timeout_sec         = {{ hc.timeout_sec }}
  healthy_threshold   = {{ hc.healthy_threshold }}
  unhealthy_threshold = {{ hc.unhealthy_threshold }}
}
{% endfor %}
{% for svc in backend_services %}
{%- if svc.endpoints %}
resource "google_compute_network_endpoint_group" "{{ svc.name | tf_id }}" {
  name                  = "{{ svc.name }}-neg"
  network               = data.google_compute_network.{{ network_name | tf_id }}.id
  network_endpoint_type = "NON_GCP_PRIVATE_IP_PORT"
  default_port          = {{ svc.port }}
  zone                  = var.zone
}

resource "google_compute_network_endpoints" "{{ svc.name | tf_id }}" {
  network_endpoint_group = google_compute_network_endpoint_group.{{ svc.name | tf_id }}.name
  zone                   = var.zone
{%- for ip in svc.endpoints %}

  network_endpoints {
    ip_address = "{{ ip }}"
    port       = {{ svc.port }}
  }
{%- endfor %}
}

{% endif -%}
resource "google_compute_backend_service" "{{ svc.name | tf_id }}" {
{%- if layer == 'l7' %}
  name                  = "{{ svc.name }}"
  protocol              = "{{ svc.protocol }}"
  session_affinity      = "{{ svc.session_affinity }}"
  health_checks         = [google_compute_health_check.{{ svc.health_check | tf_id }}.id]
  load_balancing_scheme = "EXTERNAL_MANAGED"
{%- else %}
  name             = "{{ svc.name }}"
  protocol         = "{{ svc.protocol }}"
  session_affinity = "{{ svc.session_affinity }}"
  health_checks    = [google_compute_health_check.{{ svc.health_check | tf_id }}.id]
{%- endif %}
{%- if svc.endpoints %}

  backend {
{%- if layer == 'l7' %}
    group                 = google_compute_network_endpoint_group.{{ svc.name | tf_id }}.id
    balancing_mode        = "RATE"
    max_rate_per_endpoint = 100
{%- else %}
    group = google_compute_network_endpoint_group.{{ svc.name | tf_id }}.id
{%- endif %}
  }
{%- endif %}
}
{% endfor %}
{% for rule in forwarding_rules %}
{% if layer == 'l7' -%}
resource "google_compute_url_map" "{{ rule.url_map | tf_id }}" {
  name            = "{{ rule.url_map }}"
  default_service = google_compute_backend_service.{{ rule.backend_service | tf_id }}.id
}

resource "google_compute_target_{{ rule.proxy_type }}_proxy" "{{ rule.proxy | tf_id }}" {
{%- if rule.ssl_certificate %}
  name             = "{{ rule.proxy }}"
  url_map          = google_compute_url_map.{{ rule.url_map | tf_id }}.id
  ssl_certificates = ["{{ rule.ssl_certificate }}"]
{%- else %}
  name    = "{{ rule.proxy }}"
  url_map = google_compute_url_map.{{ rule.url_map | tf_id }}.id
{%- endif %}
}

resource "google_compute_global_forwarding_rule" "{{ rule.name | tf_id }}" {
  name                  = "{{ rule.name }}"
  load_balancing_scheme = "EXTERNAL_MANAGED"
  port_range            = "{{ rule.port_range }}"
  target                = google_compute_target_{{ rule.proxy_type }}_proxy.{{ rule.proxy | tf_id }}.id
}
{% else -%}
resource "google_compute_forwarding_rule" "{{ rule.name | tf_id }}" {
  name       = "{{ rule.name }}"
  port_range = "{{ rule.port_range }}"
  target     = google_compute_backend_service.{{ rule.backend_service | tf_id }}.id
}
{% endif -%}
{% endfor -%}
