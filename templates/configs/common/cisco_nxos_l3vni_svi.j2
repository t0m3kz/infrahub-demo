{#-
  L3 VNI transit SVI for NX-OS symmetric IRB.

  Every L3 VNI needs a local VLAN and an SVI in the tenant VRF. The SVI carries
  no host addressing — `ip forward` is the whole point of it: it gives the VRF a
  forwarding interface onto the transit VNI so routed inter-subnet traffic can be
  encapsulated. Without it NX-OS accepts the `member vni X associate-vrf` line
  but silently drops routed traffic.

  `svi_vlan_id` comes from the reserved 3900-3967 band allocated in
  transforms/helpers/overlay.py. It is None when that band is exhausted (a warning
  is logged there); skip those rather than emitting `interface VlanNone`.
  `underlay_mtu` is UNDERLAY_MTU of utils/limits.py, set once in BaseDeviceTransform._build_config.

  Included by the leaf/border-leaf NX-OS templates from inside their
  `{% if vxlan and vxlan.enabled %}` guard, so `vxlan` is known non-empty here.
-#}
{%- if vxlan.l3_vni_mappings %}
!
! L3 VNI Transit SVIs (symmetric IRB — no host addressing, forwarding only)
!
{%- for mapping in vxlan.l3_vni_mappings if mapping.svi_vlan_id %}
vlan {{ mapping.svi_vlan_id }}
  name L3VNI_{{ mapping.vrf_name }}
  vn-segment {{ mapping.l3_vni }}
!
{%- set overlay = overlay_pbr_rules | default([]) | selectattr('vlan_id', 'equalto', mapping.svi_vlan_id) | list %}
{%- if overlay %}
! PBR of the traffic that enters VRF {{ mapping.vrf_name }} from the overlay: bound for a segment of a footprint, it goes to
! that footprint's firewall context (the prefixes of its segments only; the VRF is shared by every footprint).
! What returns from the firewall arrives on the transit SVI, which has no policy. documented-not-lab-verified: NX-OS
! support of PBR on the L3 VNI SVI for decapsulated traffic depends on the platform and the release.
{%- for steer in overlay[0].steers %}
ip access-list {{ steer.acl }}
{%- for prefix in steer.prefixes %}
  permit ip any {{ prefix }}
{%- endfor %}
!
route-map RM-OVERLAY-PBR-VLAN{{ mapping.svi_vlan_id }} permit {{ loop.index * 10 }}
  match ip address {{ steer.acl }}
  set ip next-hop {{ steer.fw_nexthop }}
!
{%- endfor %}
{%- endif %}
interface Vlan{{ mapping.svi_vlan_id }}
  description L3VNI transit SVI for VRF {{ mapping.vrf_name }}
  vrf member {{ mapping.vrf_name }}
  ip forward
{%- if overlay %}
  ip policy route-map RM-OVERLAY-PBR-VLAN{{ mapping.svi_vlan_id }}
{%- endif %}
  mtu {{ underlay_mtu }}
  no shutdown
!
{%- endfor %}
{%- endif -%}
