{#- Nokia SROS OSPF partial — shared across all device types.
    Expects: ospf (list from get_ospf), interfaces (list from get_interfaces) -#}
{%- if ospf %}
{%- for ospf_config in ospf %}
configure router "Base" ospf 1 admin-state enable
configure router "Base" ospf 1 router-id "{{ ospf_config.router_id.split('/')[0] }}"
{%- if ospf_config.reference_bandwidth %}
configure router "Base" ospf 1 reference-bandwidth {{ ospf_config.reference_bandwidth }}
{%- endif %}
configure router "Base" ospf 1 traffic-engineering admin-state enable
{%- for interface in interfaces %}
{%- if interface.get('ospf') %}
configure router "Base" ospf 1 interface "{{ interface.name }}" admin-state enable
configure router "Base" ospf 1 interface "{{ interface.name }}" area "{{ interface.ospf.area }}"
configure router "Base" ospf 1 interface "{{ interface.name }}" passive disable
{%- if interface.ospf.get('password') %}
{#- NOTE: authentication leaf path unverified for SR OS MD-CLI — best-effort guess #}
configure router "Base" ospf 1 interface "{{ interface.name }}" authentication-type password
configure router "Base" ospf 1 interface "{{ interface.name }}" authentication-key "{{ interface.ospf.password }}"
{%- endif %}
{%- else %}
configure router "Base" ospf 1 interface "{{ interface.name }}" passive enable
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif -%}
