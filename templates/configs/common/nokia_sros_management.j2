{#- Nokia SROS management partial — flat MD-CLI form, consistent with
    nokia_sros_bgp.j2/nokia_sros_ospf.j2/nokia_sros_mclag.j2 (every command is
    a full path from "configure", no nested block/exit). -#}
{%- if ntp %}
!
! NTP
!
configure system time ntp admin-state enable
{%- for s in ntp.servers %}
configure system time ntp server "{{ s.address }}"{% if s.prefer %} prefer{% endif %}
{%- endfor %}
{%- endif %}
{%- if syslog %}
!
! Syslog
!
{%- for s in syslog.servers %}
configure log log-id 10 description "syslog"
configure log log-id 10 source main
configure log log-id 10 destination syslog "{{ s.address }}"
{%- endfor %}
{%- endif %}
{%- if snmp %}
!
! SNMP
!
{%- if snmp.community_ro %}
configure system security snmp community "{{ snmp.community_ro }}" access-permissions r
{%- endif %}
{%- if snmp.location %}
configure system location "{{ snmp.location }}"
{%- endif %}
{%- if snmp.contact %}
configure system contact "{{ snmp.contact }}"
{%- endif %}
{%- endif %}
{%- if aaa %}
!
! AAA
!
{%- for s in aaa.servers %}
{%- if s.protocol == 'tacacs' %}
configure system security tacplus server {{ loop.index }} address "{{ s.address }}"{% if s.port %} port {{ s.port }}{% endif %}{% if s.timeout %} timeout {{ s.timeout }}{% endif %}
{%- endif %}
{%- endfor %}
{%- if aaa.authentication_order in ('tacacs_local', 'radius_local') %}
configure system security aaa local-profiles admin-state enable
configure system security aaa tacplus-plus-authorization admin-state enable
{%- endif %}
{%- endif %}
