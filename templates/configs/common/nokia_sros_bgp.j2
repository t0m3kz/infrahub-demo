{#- Nokia SROS BGP partial — shared across all device types.
    Expects: bgp (list of BGP configs from get_bgp_profile)
    Uses peer_groups, sessions, address_families from BGP profile for
    consistent underlay/overlay rendering. -#}
{%- if bgp %}
{%- for bgp_config in bgp %}
configure router "Base" bgp 1 admin-state enable
configure router "Base" bgp 1 router-id "{{ bgp_config.router_id.address.split('/')[0] }}"
configure router "Base" bgp 1 local-as {{ bgp_config.local_as.asn }}
configure router "Base" bgp 1 ebgp-default-reject-policy import false
configure router "Base" bgp 1 ebgp-default-reject-policy export false
{%- if bgp_config.graceful_restart %}
configure router "Base" bgp 1 graceful-restart admin-state enable
{%- endif %}
{%- if bgp_config.multipath %}
configure router "Base" bgp 1 multipath max-paths 64
{%- endif %}
{#- Peer groups #}
{%- for pg in bgp_config.peer_groups | default([]) %}
configure router "Base" bgp 1 group "{{ pg.name }}" admin-state enable
{%- if pg.get('remote_as') %}
configure router "Base" bgp 1 group "{{ pg.name }}" peer-as {{ pg.remote_as }}
{%- endif %}
{%- if pg.type == 'overlay' %}
configure router "Base" bgp 1 group "{{ pg.name }}" local-address "{{ bgp_config.router_id.address.split('/')[0] }}"
configure router "Base" bgp 1 group "{{ pg.name }}" family evpn
{%- if pg.route_reflector_client is defined and pg.route_reflector_client %}
configure router "Base" bgp 1 group "{{ pg.name }}" cluster {{ bgp_config.router_id.address.split('/')[0] }}
{%- endif %}
{%- endif %}
{%- if 'ipv4' in (pg.address_families | default([])) %}
configure router "Base" bgp 1 group "{{ pg.name }}" family ipv4
{%- endif %}
{%- if 'ipv6' in (pg.address_families | default([])) %}
configure router "Base" bgp 1 group "{{ pg.name }}" family ipv6
{%- endif %}
{%- if pg.get('ebgp_multihop') %}
configure router "Base" bgp 1 group "{{ pg.name }}" multihop {{ pg.ebgp_multihop }}
{%- endif %}
{%- if pg.get('bfd_enabled') %}
configure router "Base" bgp 1 group "{{ pg.name }}" bfd-liveness true
{%- endif %}
{%- if pg.get('send_extended_community') %}
configure router "Base" bgp 1 group "{{ pg.name }}" send-community extended
{%- elif pg.get('send_community') %}
configure router "Base" bgp 1 group "{{ pg.name }}" send-community standard
{%- endif %}
{%- if pg.get('remove_private_as') %}
# NOTE: remove-private-as leaf name unverified for SR OS MD-CLI — best-effort guess
configure router "Base" bgp 1 group "{{ pg.name }}" remove-private-as true
{%- endif %}
{%- if pg.get('maximum_routes') %}
# NOTE: prefix-limit leaf path unverified for SR OS MD-CLI — best-effort guess
configure router "Base" bgp 1 group "{{ pg.name }}" prefix-limit ipv4 maximum {{ pg.maximum_routes }}
{%- endif %}
{%- endfor %}
{%- for session in bgp_config.sessions %}
{%- if session.get('local_pref') %}
configure router "Base" policy-options policy-statement "{{ session.name }}-LOCAL-PREF-IN" entry 10 action local-preference set {{ session.local_pref }}
configure router "Base" policy-options policy-statement "{{ session.name }}-LOCAL-PREF-IN" entry 10 action action-type accept
{%- endif %}
{%- if session.get('med') %}
configure router "Base" policy-options policy-statement "{{ session.name }}-MED-OUT" entry 10 action metric set {{ session.med }}
configure router "Base" policy-options policy-statement "{{ session.name }}-MED-OUT" entry 10 action action-type accept
{%- endif %}
{%- endfor %}
{#- BGP Neighbors #}
{%- for session in bgp_config.sessions %}
{%- set is_unnumbered = session.get('interface_name') and not session.get('remote_ip') %}
{%- set remote_ip = session.interface_name if is_unnumbered else session.remote_ip.address.split('/')[0] %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" admin-state enable
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" peer-as {{ session.remote_as.asn }}
{#- See _bgp_local_as_eos.j2 for why this exists. SR OS splits the two keywords
    into separate leaves under `local-as`: `prepend-global-as false` is its
    `no-prepend`, and `private true` keeps the overridden ASN out of the
    advertised AS-path the way `replace-as` does. #}
{%- if session.get('local_as_override') %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" local-as as-number {{ session.local_as_override.asn }}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" local-as prepend-global-as false
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" local-as private true
{%- endif %}
{%- if session.get('remote_device') %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" description "{{ session.remote_device }}"
{%- endif %}
{%- if session.peer_group is defined %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" group "{{ session.peer_group }}"
{%- else %}
{%- set _afs = session.address_families | default([]) %}
{%- if 'evpn' in _afs %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" local-address "{{ bgp_config.router_id.address.split('/')[0] }}"
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" family evpn
{%- if session.get('route_reflector_client') %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" cluster {{ bgp_config.router_id.address.split('/')[0] }}
{%- endif %}
{%- endif %}
{%- if 'ipv4' in _afs %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" family ipv4
{%- endif %}
{%- if 'ipv6' in _afs %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" family ipv6
{%- endif %}
{%- if session.get('send_extended_community') %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" send-community extended
{%- elif session.get('send_community') %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" send-community standard
{%- endif %}
{%- if session.get('remove_private_as') %}
# NOTE: remove-private-as leaf name unverified for SR OS MD-CLI — best-effort guess
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" remove-private-as true
{%- endif %}
{%- if session.get('bfd_enabled') %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" bfd-liveness true
{%- endif %}
{%- endif %}
{%- if session.get('maximum_routes') %}
# NOTE: prefix-limit leaf path unverified for SR OS MD-CLI — best-effort guess
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" prefix-limit ipv4 maximum {{ session.maximum_routes }}
{%- endif %}
{%- if session.get('password') %}
# NOTE: authentication-key leaf name unverified for SR OS MD-CLI — best-effort guess
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" authentication-key "{{ session.password }}"
{%- endif %}
{%- if session.get('local_pref') %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" import policy "{{ session.name }}-LOCAL-PREF-IN"
{%- endif %}
{%- if session.get('med') %}
configure router "Base" bgp 1 neighbor "{{ remote_ip }}" export policy "{{ session.name }}-MED-OUT"
{%- endif %}
{%- endfor %}
{#- Export policy for connected routes #}
configure router "Base" bgp 1 export policy "RM-CONN-2-BGP"
{%- endfor %}
{%- endif -%}
