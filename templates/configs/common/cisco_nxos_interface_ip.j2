{%- if interface.ip_addresses %}
{%- set ns_name = interface.ip_addresses[0].get('ip_namespace', {}).get('name', 'default') %}
{%- if ns_name != 'default' %}
  vrf member {{ ns_name }}
{%- endif %}
{%- for ip in interface.ip_addresses %}
{%- if ':' in ip.address %}
  ipv6 address {{ ip.address }}
{%- else %}
  ip address {{ ip.address }}
{%- endif %}
{%- endfor %}
{%- endif %}

{#- A DCI port (evpn multisite dci-tracking) carries the routed-port MTU the generator set. #}
{%- if vxlan and vxlan.multisite and interface.name in vxlan.multisite.dci_interfaces and interface.mtu %}
  mtu {{ interface.mtu }}
{%- endif %}
