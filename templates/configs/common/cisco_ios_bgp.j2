{%- if capabilities is not defined or capabilities.bgp_enabled is not defined or capabilities.bgp_enabled %}
{%- for bgp_config in bgp %}
router bgp {{ bgp_config.local_as.asn }}
  bgp router-id {{ bgp_config.router_ip }}
{%- if bgp_config.graceful_restart %}
  bgp graceful-restart
{%- endif %}
{%- if bgp_config.multipath %}
  maximum-paths 4
{%- endif %}
{%- for pg in bgp_config.peer_groups | default([]) %}
  !
  neighbor {{ pg.name }} peer-group
{%- if pg.get('remote_as') %}
  neighbor {{ pg.name }} remote-as {{ pg.remote_as }}
{%- endif %}
{%- if pg.type == 'overlay' %}
  neighbor {{ pg.name }} update-source Loopback0
{%- endif %}
{%- if pg.get('send_community') and pg.get('send_extended_community') %}
  neighbor {{ pg.name }} send-community both
{%- elif pg.get('send_extended_community') %}
  neighbor {{ pg.name }} send-community extended
{%- elif pg.get('send_community') %}
  neighbor {{ pg.name }} send-community standard
{%- endif %}
{%- if pg.get('remove_private_as') %}
  neighbor {{ pg.name }} remove-private-as
{%- endif %}
{%- if pg.get('bfd_enabled') %}
  neighbor {{ pg.name }} fall-over bfd
{%- endif %}
{%- if pg.get('ebgp_multihop') %}
  neighbor {{ pg.name }} ebgp-multihop {{ pg.ebgp_multihop }}
{%- endif %}
{%- endfor %}
{%- for session in bgp_config.sessions %}
{%- if session.get('local_pref') %}
  route-map {{ session.name }}-LOCAL-PREF-IN permit 10
    set local-preference {{ session.local_pref }}
  !
{%- endif %}
{%- if session.get('med') %}
  route-map {{ session.name }}-MED-OUT permit 10
    set metric {{ session.med }}
  !
{%- endif %}
{%- endfor %}
{%- for session in bgp_config.sessions if not session.get('vrf') %}
{%- if session.peer_group is defined %}
  neighbor {{ session.neighbor }} peer-group {{ session.peer_group }}
{%- if not session.get('remote_as_from_peer_group') %}
  neighbor {{ session.neighbor }} remote-as {{ session.remote_as.asn }}
{%- endif %}
{#- See _bgp_local_as_eos.j2 for why this exists and why both keywords are
    required; classic IOS spells it the same way. #}
{%- if session.get('local_as_override') %}
  neighbor {{ session.neighbor }} local-as {{ session.local_as_override.asn }} no-prepend replace-as
{%- endif %}
{%- else %}
  neighbor {{ session.neighbor }} remote-as {{ session.remote_as.asn }}
{%- if session.get('local_as_override') %}
  neighbor {{ session.neighbor }} local-as {{ session.local_as_override.asn }} no-prepend replace-as
{%- endif %}
{%- if session.get('ttl') != 1 %}
  neighbor {{ session.neighbor }} update-source Loopback0
{%- endif %}
{%- if session.get('send_community') and session.get('send_extended_community') %}
  neighbor {{ session.neighbor }} send-community both
{%- elif session.get('send_extended_community') %}
  neighbor {{ session.neighbor }} send-community extended
{%- elif session.get('send_community') %}
  neighbor {{ session.neighbor }} send-community standard
{%- endif %}
{%- if session.get('remove_private_as') %}
  neighbor {{ session.neighbor }} remove-private-as
{%- endif %}
{%- if session.get('bfd_enabled') %}
  neighbor {{ session.neighbor }} fall-over bfd
{%- endif %}
{%- endif %}
{%- if session.get('remote_device') %}
  neighbor {{ session.neighbor }} description {{ session.remote_device }}
{%- endif %}
{%- if session.get('maximum_routes') %}
  neighbor {{ session.neighbor }} maximum-prefix {{ session.maximum_routes }}
{%- endif %}
{%- if session.get('password') %}
  neighbor {{ session.neighbor }} password {{ session.password }}
{%- endif %}
{%- if session.get('local_pref') %}
  neighbor {{ session.neighbor }} route-map {{ session.name }}-LOCAL-PREF-IN in
{%- endif %}
{%- if session.get('med') %}
  neighbor {{ session.neighbor }} route-map {{ session.name }}-MED-OUT out
{%- endif %}
{%- endfor %}
  !
  address-family ipv4 unicast
    redistribute connected route-map RM-CONN-2-BGP
{%- for pg in bgp_config.peer_groups | default([]) %}
{%- if 'ipv4' in (pg.address_families | default([])) %}
    neighbor {{ pg.name }} activate
{%- endif %}
{%- endfor %}
{%- for session in bgp_config.sessions if not session.get('vrf') %}
{%- if session.peer_group is not defined and 'ipv4' in (session.address_families | default([])) %}
    neighbor {{ session.neighbor }} activate
{%- endif %}
{%- endfor %}
  exit-address-family
{%- if bgp_config.has_evpn %}
  !
  address-family l2vpn evpn
{%- for pg in bgp_config.peer_groups | default([]) %}
{%- if 'evpn' in (pg.address_families | default([])) %}
    neighbor {{ pg.name }} activate
{%- if pg.route_reflector_client is defined and pg.route_reflector_client %}
    neighbor {{ pg.name }} route-reflector-client
{%- endif %}
{%- endif %}
{%- endfor %}
{%- for session in bgp_config.sessions if not session.get('vrf') %}
{%- if session.peer_group is not defined and 'evpn' in (session.address_families | default([])) %}
    neighbor {{ session.neighbor }} activate
{%- if session.get('route_reflector_client') %}
    neighbor {{ session.neighbor }} route-reflector-client
{%- endif %}
{%- endif %}
{%- endfor %}
  exit-address-family
{%- endif %}
{#- VRF neighbours: eBGP handoffs whose local address sits in a tenant
    namespace (transforms/helpers/bgp.py sets session.vrf). Classic IOS
    configures them entirely inside the VRF's address-family. -#}
{%- for vrf_name, _by_af in bgp_config.vrf_af_sessions.items() %}
{%- for _af, _af_sessions in _by_af.items() %}
  !
  address-family {{ _af }} vrf {{ vrf_name }}
{%- for session in _af_sessions %}
    neighbor {{ session.neighbor }} remote-as {{ session.remote_as.asn }}
{%- if session.get('remote_device') %}
    neighbor {{ session.neighbor }} description {{ session.remote_device }}
{%- endif %}
{%- if session.get('send_community') and session.get('send_extended_community') %}
    neighbor {{ session.neighbor }} send-community both
{%- elif session.get('send_extended_community') %}
    neighbor {{ session.neighbor }} send-community extended
{%- elif session.get('send_community') %}
    neighbor {{ session.neighbor }} send-community standard
{%- endif %}
{%- if session.get('bfd_enabled') %}
    neighbor {{ session.neighbor }} fall-over bfd
{%- endif %}
{%- if session.get('maximum_routes') %}
    neighbor {{ session.neighbor }} maximum-prefix {{ session.maximum_routes }}
{%- endif %}
{%- if session.get('password') %}
    neighbor {{ session.neighbor }} password {{ session.password }}
{%- endif %}
{%- if session.get('local_pref') %}
    neighbor {{ session.neighbor }} route-map {{ session.name }}-LOCAL-PREF-IN in
{%- endif %}
{%- if session.get('med') %}
    neighbor {{ session.neighbor }} route-map {{ session.name }}-MED-OUT out
{%- endif %}
    neighbor {{ session.neighbor }} activate
{%- endfor %}
  exit-address-family
{%- endfor %}
{%- endfor %}
!
{%- endfor %}
{%- else %}
! BGP disabled by capability profile
{%- endif %}
