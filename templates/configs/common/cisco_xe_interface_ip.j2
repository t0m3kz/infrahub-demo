{#- IOS-XE interface addressing, `interface` in scope. IOS-XE takes dotted masks (no prefix notation), and a
    non-default namespace is a `vrf forwarding`, which must precede the address. -#}
{%- if interface.ip_addresses %}
{%- set ns_name = interface.ip_addresses[0].get('ip_namespace', {}).get('name', 'default') %}
{%- if ns_name != 'default' %}
 vrf forwarding {{ ns_name }}
{%- endif %}
{%- for ip in interface.ip_addresses %}
{%- if ':' in ip.address %}
 ipv6 address {{ ip.address }}
{%- else %}
 ip address {{ ip.address.split('/')[0] }} {{ ip.address.split('/')[1] | int | cidr_to_netmask }}
{%- endif %}
{%- endfor %}
{%- endif -%}
