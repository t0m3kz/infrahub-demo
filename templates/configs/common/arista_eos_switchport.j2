{#- Expects `interface` in scope. Trunk when interface.mode == 'trunk', else access on the
    first VLAN; eos_port_protection adds `switchport protected` on isolated access ports. -#}
{%- if interface.mode == 'trunk' %}
   switchport mode trunk
   switchport trunk allowed vlan {{ interface.vlans|join(',') }}
{%- elif interface.vlans %}
   switchport access vlan {{ interface.vlans[0] }}
{%- if eos_port_protection and interface.access_isolation_mode == 'isolated' %}
   switchport protected
{%- endif %}
{%- endif -%}
