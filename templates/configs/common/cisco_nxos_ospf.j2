{%- if capabilities is not defined or capabilities.ospf_enabled is not defined or capabilities.ospf_enabled %}
{%- for ospf_config in ospf %}
{%- set process_id = ospf_config.process_id or 1 %}
router ospf {{ process_id }}
  router-id {{ ospf_config.router_id.split('/')[0] }}
{%- if ospf_config.reference_bandwidth %}
  auto-cost reference-bandwidth {{ ospf_config.reference_bandwidth }}
{%- endif %}
{%- if ospf_config.area is defined %}
  area {{ ospf_config.area }} authentication message-digest
{%- endif %}
  passive-interface default
{%- for interface in interfaces %}
{%- if interface.get('ospf') and (ospf_config.area is not defined or interface.ospf.area == ospf_config.area) %}
  no passive-interface {{ interface.name }}
{%- endif %}
{%- endfor %}
!
{%- endfor %}
{%- for interface in interfaces %}
{%- if interface.get('ospf') %}
{%- set ospf = interface.ospf %}
{%- set pid = ospf.process_id or 1 %}
interface {{ interface.name }}
{%- if ospf.area is not none %}
  ip router ospf {{ pid }} area {{ ospf.area }}
{%- endif %}
{%- if ospf.mode == 'peer_to_peer' %}
  ip ospf network point-to-point
{%- elif ospf.mode == 'passive' %}
  ip ospf passive-interface
{%- endif %}
{%- if ospf.metric is not none %}
  ip ospf cost {{ ospf.metric }}
{%- endif %}
{%- if ospf.get('password') %}
{%- if ospf.get('authentication_mode') == 'md5' %}
  ip ospf authentication message-digest
  ip ospf message-digest-key 1 md5 {{ ospf.password }}
{%- else %}
  ip ospf authentication
  ip ospf authentication-key {{ ospf.password }}
{%- endif %}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
