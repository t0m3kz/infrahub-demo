{%- set _lb = namespace(name='loopback0') %}
{%- for iface in interfaces %}
{%- if iface.name | lower | truncate(8, true, '') == 'loopback' and _lb.name == 'loopback0' %}
{%- set _lb.name = iface.name %}
{%- endif %}
{%- endfor %}
{%- if capabilities is not defined or capabilities.bgp_enabled is not defined or capabilities.bgp_enabled %}
{%- for bgp_config in bgp %}
router bgp {{ bgp_config.local_as.asn }}
  router-id {{ bgp_config.router_id.address.split('/')[0] }}
{%- if bgp_config.get('cluster_id') %}
  bgp cluster-id {{ bgp_config.cluster_id }}
{%- endif %}
{%- if bgp_config.graceful_restart %}
  graceful-restart
{%- endif %}
{%- for pg in bgp_config.peer_groups | default([]) %}
  !
  template peer-policy {{ pg.name }}-POLICY
{%- if pg.get('send_community') %}
    send-community
{%- endif %}
{%- if pg.get('send_extended_community') %}
    send-community extended
{%- endif %}
{%- if pg.get('remove_private_as') %}
    remove-private-as
{%- endif %}
{%- if pg.route_reflector_client is defined and pg.route_reflector_client %}
    route-reflector-client
{%- endif %}
{%- if pg.get('next_hop_unchanged') %}
    next-hop-unchanged
{%- endif %}
  !
  template peer-session {{ pg.name }}-SESSION
{%- if pg.type == 'overlay' %}
    update-source {{ _lb.name }}
{%- endif %}
{%- if pg.get('ebgp_multihop') %}
    ebgp-multihop {{ pg.ebgp_multihop }}
{%- endif %}
{%- if pg.get('bfd_enabled') %}
    bfd
{%- endif %}
  !
{%- endfor %}
{%- for session in bgp_config.sessions %}
{%- if session.get('local_pref') %}
  route-map {{ session.name }}-LOCAL-PREF-IN permit 10
    set local-preference {{ session.local_pref }}
  !
{%- endif %}
{%- if session.get('med') %}
  route-map {{ session.name }}-MED-OUT permit 10
    set metric {{ session.med }}
  !
{%- endif %}
{%- endfor %}
  address-family ipv4 unicast
    redistribute direct route-map RM-CONN-2-BGP
{%- if bgp_config.multipath %}
    maximum-paths 8
{%- endif %}
  !
{%- set ns = namespace(has_ipv6=false) %}
{%- for session in bgp_config.sessions if not session.get('vrf') %}
{%- if 'ipv6' in (session.address_families | default([])) %}{% set ns.has_ipv6 = true %}{% endif %}
{%- endfor %}
{%- if ns.has_ipv6 %}
  address-family ipv6 unicast
    redistribute direct route-map RM-CONN-2-BGP
{%- if bgp_config.multipath %}
    maximum-paths 8
{%- endif %}
  !
{%- endif %}
  address-family l2vpn evpn
{#- A relaying tier (spine/super-spine) has no VRF and no L2VNI, so it holds no
    import route-target and NX-OS would discard the EVPN NLRI it exists to pass
    on. Set by transforms/helpers/bgp.py on the overlay peer group. -#}
{%- set rt_ns = namespace(retain=false) %}
{%- for pg in bgp_config.peer_groups | default([]) %}
{%- if pg.get('retain_route_target_all') %}{% set rt_ns.retain = true %}{% endif %}
{%- endfor %}
{%- if rt_ns.retain %}
    retain route-target all
{%- endif %}
  !
{%- for session in bgp_config.sessions if not session.get('vrf') %}
{%- set is_unnumbered = session.get('interface_name') and not session.get('remote_ip') %}
{%- set neighbor_id = session.interface_name if is_unnumbered else session.remote_ip.address.split('/')[0] %}
  neighbor {{ neighbor_id }}
    remote-as {{ session.remote_as.asn }}
{#- See _bgp_local_as_eos.j2 for why this exists and why both keywords are
    required; NX-OS spells it the same way. #}
{%- if session.get('local_as_override') %}
    local-as {{ session.local_as_override.asn }} no-prepend replace-as
{%- endif %}
{%- if session.get('remote_device') %}
    description {{ session.remote_device }}
{%- endif %}
{#- EVPN Multi-Site DCI neighbour (transforms/helpers/bgp.py DCI-PEERS). #}
{%- if session.get('peer_type') %}
    peer-type {{ session.peer_type }}
{%- endif %}
{%- if session.get('password') %}
    password {{ session.password }}
{%- endif %}
{%- if session.peer_group is defined %}
    inherit peer-session {{ session.peer_group }}-SESSION
{%- else %}
{%- if session.get('ttl') != 1 %}
    update-source {{ _lb.name }}
{%- endif %}
{%- if session.get('bfd_enabled') %}
    bfd
{%- endif %}
{%- endif %}
{%- set _afs = session.address_families | default([]) %}
{%- if 'ipv6' in _afs %}
    address-family ipv6 unicast
{%- if session.peer_group is defined %}
      inherit peer-policy {{ session.peer_group }}-POLICY
{%- else %}
{%- if session.get('send_community') %}
      send-community
{%- endif %}
{%- if session.get('send_extended_community') %}
      send-community extended
{%- endif %}
{%- if session.get('remove_private_as') %}
      remove-private-as
{%- endif %}
{%- endif %}
{%- if session.get('maximum_routes') %}
      maximum-prefix {{ session.maximum_routes }}
{%- endif %}
{%- if session.get('local_pref') %}
      route-map {{ session.name }}-LOCAL-PREF-IN in
{%- endif %}
{%- if session.get('med') %}
      route-map {{ session.name }}-MED-OUT out
{%- endif %}
    !
{%- endif %}
{%- if 'ipv4' in _afs %}
    address-family ipv4 unicast
{%- if session.peer_group is defined %}
      inherit peer-policy {{ session.peer_group }}-POLICY
{%- else %}
{%- if session.get('send_community') %}
      send-community
{%- endif %}
{%- if session.get('send_extended_community') %}
      send-community extended
{%- endif %}
{%- if session.get('remove_private_as') %}
      remove-private-as
{%- endif %}
{%- endif %}
{%- if session.get('maximum_routes') %}
      maximum-prefix {{ session.maximum_routes }}
{%- endif %}
{%- if session.get('local_pref') %}
      route-map {{ session.name }}-LOCAL-PREF-IN in
{%- endif %}
{%- if session.get('med') %}
      route-map {{ session.name }}-MED-OUT out
{%- endif %}
    !
{%- endif %}
{%- if 'evpn' in _afs %}
    address-family l2vpn evpn
{%- if session.peer_group is defined %}
      inherit peer-policy {{ session.peer_group }}-POLICY
{%- else %}
{%- if session.get('send_community') %}
      send-community
{%- endif %}
{%- if session.get('send_extended_community') %}
      send-community extended
{%- endif %}
{%- if session.get('remove_private_as') %}
      remove-private-as
{%- endif %}
{%- if session.get('route_reflector_client') %}
      route-reflector-client
{%- endif %}
{%- if session.get('next_hop_unchanged') %}
      next-hop-unchanged
{%- endif %}
{%- endif %}
    !
{%- endif %}
{%- endfor %}
{#- Per-tenant VRF address-family: the other half of symmetric IRB.

    `vrf context` (cisco_nxos_vxlan_vrf.j2) gives the VRF its L3 VNI and route-
    targets; this block is what actually puts the VRF's prefixes into EVPN as
    type-5 routes. `advertise l2vpn evpn` alone is not enough — the prefixes have
    to be in the VRF's BGP table first, which is what `redistribute direct` does.
    RM-CONN-2-BGP cannot be reused here: it matches loopback0, which lives in the
    default VRF, so it would select nothing and the tenant subnets would never
    leave this leaf.

    Gated on this process actually carrying the EVPN address-family. Under
    ebgp-ibgp a device has two `router bgp` stanzas (underlay ASN + overlay ASN)
    and only the overlay one may own the tenant VRFs; emitting under both would
    make NX-OS reject the second. `vxlan` is undefined on spine templates that
    include this partial — non-strict Undefined makes that falsy, not an error. -#}
{%- set evpn_ns = namespace(carries_evpn=false) %}
{%- for session in bgp_config.sessions %}
{%- if 'evpn' in (session.address_families | default([])) %}{% set evpn_ns.carries_evpn = true %}{% endif %}
{%- endfor %}
{%- set _evpn_vrfs = (vxlan.l3_vni_mappings | map(attribute='vrf_name') | list) if (vxlan and vxlan.l3_vni_mappings and evpn_ns.carries_evpn) else [] %}
{#- VRF neighbours: eBGP handoffs whose local address sits in a tenant
    namespace (transforms/helpers/bgp.py sets session.vrf), e.g. the
    colocation edge's PROD handoff to the SD-WAN gateway. They are kept out of
    the global peer groups and rendered here, inside their VRF. -#}
{%- set _vrf_sessions = bgp_config.sessions | selectattr('vrf', 'defined') | selectattr('vrf') | list %}
{%- for vrf_name in (_evpn_vrfs + (_vrf_sessions | map(attribute='vrf') | list)) | unique %}
  vrf {{ vrf_name }}
    address-family ipv4 unicast
{%- if vrf_name in _evpn_vrfs %}
      advertise l2vpn evpn
      redistribute direct route-map RM-VRF-DIRECT-2-EVPN
{%- endif %}
{%- for session in _vrf_sessions if session.vrf == vrf_name %}
{%- set _af = 'ipv6' if 'ipv6' in (session.address_families | default([])) else 'ipv4' %}
    neighbor {{ session.remote_ip.address.split('/')[0] }}
      remote-as {{ session.remote_as.asn }}
{%- if session.get('remote_device') %}
      description {{ session.remote_device }}
{%- endif %}
{%- if session.get('password') %}
      password {{ session.password }}
{%- endif %}
{%- if session.get('bfd_enabled') %}
      bfd
{%- endif %}
      address-family {{ _af }} unicast
{%- if session.get('send_community') %}
        send-community
{%- endif %}
{%- if session.get('send_extended_community') %}
        send-community extended
{%- endif %}
{%- if session.get('maximum_routes') %}
        maximum-prefix {{ session.maximum_routes }}
{%- endif %}
{%- endfor %}
  !
{%- endfor %}
!
{%- endfor %}
{%- else %}
! BGP disabled by capability profile
{%- endif %}
