{#- Cisco ASA — zone-based firewall configuration -#}
{#- One ACL per source zone; a context has a single customer-pbr interface,
    so its rules share one ACL bound there (acl_name). -#}
{#- ASA takes IPv4 networks as "address netmask" and a /32 as "host address";
    IPv6 keeps prefix notation. -#}
{%- macro asa_addr(cidr) -%}
{%- if not cidr -%}any
{%- elif ':' in cidr -%}{{ cidr }}
{%- elif cidr.endswith('/32') -%}host {{ cidr.split('/')[0] }}
{%- else -%}{{ cidr.split('/')[0] }} {{ cidr.split('/')[1] | int | cidr_to_netmask }}
{%- endif -%}
{%- endmacro -%}
{%- macro asa_ip(address) -%}
{{ address.split('/')[0] }} {{ address.split('/')[1] | int | cidr_to_netmask }}
{%- endmacro -%}
{%- macro access_lists(policies, acl_name=none) %}
{%- for policy in policies %}
{%- for rule in policy.rules %}
access-list {{ acl_name or ((rule.src_zone or 'global') + '-in') }} extended {{ 'permit' if rule.action == 'permit' else 'deny' }} {{ rule.protocol }} {{ asa_addr(rule.src) }} {{ asa_addr(rule.dst) }}{{ ' ' + rule.dst_port if rule.dst_port else '' }}{{ ' log' if rule.log else '' }}
{%- endfor %}
{%- endfor %}
{%- endmacro -%}
!
hostname {{ name }}
!
{%- if fw_interfaces %}
! --- Interfaces ---
{%- for iface in fw_interfaces %}
{%- if iface.vlan_id and iface.parent_interface %}
interface {{ iface.parent_interface.name }}.{{ iface.vlan_id }}
 vlan {{ iface.vlan_id }}
{%- else %}
interface {{ iface.name }}
{%- endif %}
{%- if iface.ip_address %}
{#- On an HA pair terminating the segment inline, the active unit holds the
    gateway (virtual_ip) and the standby unit the secondary's own address. -#}
{%- set addr = iface.virtual_ip or iface.ip_address.address %}
{%- if ':' in addr %}
 ipv6 address {{ addr }}{{ ' standby ' + iface.standby_ip.split('/')[0] if iface.standby_ip else '' }}
{%- else %}
 ip address {{ asa_ip(addr) }}{{ ' standby ' + iface.standby_ip.split('/')[0] if iface.standby_ip else '' }}
{%- endif %}
{%- endif %}
{%- if iface.security_zone %}
 nameif {{ iface.security_zone.name }}
 security-level {{ iface.security_zone.trust_level }}
{%- endif %}
{%- if iface.description %}
 description {{ iface.description }}
{%- endif %}
 no shutdown
!
{%- endfor %}
{%- endif %}
{%- if static_routes %}
! --- Static Routes (return path to leaf per zone) ---
{%- for route in static_routes %}
route {{ route.zone }} {{ asa_addr(route.destination) }} {{ route.nexthop }} 1
{%- endfor %}
!
{%- endif %}
{%- if zone_policies %}
! --- Access Control Lists ---
{{- access_lists(zone_policies) }}
!
! --- Access Groups ---
{%- for iface in fw_interfaces %}
{%- if iface.security_zone %}
access-group {{ iface.security_zone.name }}-in in interface {{ iface.security_zone.name }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if contexts %}
!
! --- Firewall Contexts (Security Contexts) — one per tenant, per ManagedFirewallContext ---
! mode multiple must already be set on this ASA (system exec space, requires reload) —
! not idempotently re-set here.
{%- for context in contexts %}
{%- if context.vlan_id and context.parent_interface.name %}
interface {{ context.parent_interface.name }}.{{ context.vlan_id }}
 vlan {{ context.vlan_id }}
 no shutdown
!
{%- endif %}
{%- endfor %}
{%- for context in contexts %}
context {{ context.name }}
{%- if context.vlan_id and context.parent_interface.name %}
 allocate-interface {{ context.parent_interface.name }}.{{ context.vlan_id }}
{%- endif %}
 config-url disk0:/{{ context.name }}.cfg
{%- if context.tenant_name %}
 description {{ context.tenant_name }}
{%- endif %}
!
{%- endfor %}
{%- for context in contexts %}
{%- if context.vlan_id and context.parent_interface.name and context.ip_address %}
changeto context {{ context.name }}
interface {{ context.parent_interface.name }}.{{ context.vlan_id }}
{%- if ':' in context.ip_address %}
 ipv6 address {{ context.ip_address }}
{%- else %}
 ip address {{ asa_ip(context.ip_address) }}
{%- endif %}
 nameif customer-pbr
 security-level 50
 no shutdown
!
{%- endif %}
{%- endfor %}
{%- for context in contexts if context.policies %}
changeto context {{ context.name }}
! --- Access Control Lists in context {{ context.name }} ---
{{- access_lists(context.policies, 'customer-pbr-in') }}
{%- if context.vlan_id and context.parent_interface.name and context.ip_address %}
access-group customer-pbr-in in interface customer-pbr
{%- endif %}
!
{%- endfor %}
{%- endif %}
{%- if ha %}
!
! --- Failover (HA) ---
{%- if ha.unit %}
failover lan unit {{ ha.unit }}
{%- endif %}
{%- if ha.ha_link %}
failover lan interface FOLINK {{ ha.ha_link }}
failover link FOLINK {{ ha.ha_link }}
failover interface ip FOLINK {{ asa_ip(ha.link_addresses.primary) }} standby {{ ha.link_addresses.secondary.split('/')[0] }}
{%- endif %}
{%- if ha.mode == 'active-active' %}
failover group {{ ha.group_id }}
 primary
{%- endif %}
failover
!
{%- endif %}
end
