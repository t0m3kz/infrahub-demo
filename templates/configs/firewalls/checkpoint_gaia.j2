{#- Check Point Gaia — zone-based firewall configuration -#}
{%- macro security_policies(policies) %}
! --- Security Policy Rules ---
{%- for policy in policies %}
{%- for rule in policy.rules %}
{%- if rule.raw_protocol in ('tcp', 'udp') and rule.port_start %}
{%- set svc_name = 'svc-' + rule.raw_protocol + '-' + rule.port_start | string + ('-' + rule.port_end | string if rule.port_end and rule.port_end != rule.port_start else '') %}
add service-{{ rule.raw_protocol }} name {{ svc_name }} port {{ rule.port_start }}{{ '-' + rule.port_end | string if rule.port_end and rule.port_end != rule.port_start else '' }}
{%- else %}
{%- set svc_name = 'Any' %}
{%- endif %}
add access-rule layer "Network" position {{ rule.seq }} name "{{ rule.name }}" action {{ 'accept' if rule.action == 'permit' else 'drop' }} source {{ rule.src or 'Any' }} destination {{ rule.dst or 'Any' }} service {{ svc_name }} track {{ 'Log' if rule.log else 'None' }}
{%- if rule.src_zone %}
set access-rule layer "Network" name "{{ rule.name }}" source {{ rule.src_zone }}
{%- endif %}
{%- if rule.dst_zone %}
set access-rule layer "Network" name "{{ rule.name }}" destination {{ rule.dst_zone }}
{%- endif %}
{%- endfor %}
{%- endfor %}
!
{%- endmacro -%}
!
set hostname {{ name }}
!
{%- if fw_interfaces %}
! --- Interfaces ---
{%- for iface in fw_interfaces %}
{%- if iface.vlan_id and iface.parent_interface %}
{%- set iface_name = iface.parent_interface.name + '.' + iface.vlan_id | string %}
set interface {{ iface_name }} vlan {{ iface.vlan_id }}
set interface {{ iface_name }} state on
{%- if iface.ip_address %}
set interface {{ iface_name }} {{ 'ipv6-address' if ':' in iface.ip_address.address else 'ipv4-address' }} {{ iface.ip_address.address | replace('/', ' mask-length ') }}
{%- endif %}
{%- if iface.security_zone %}
set interface {{ iface_name }} security-zone {{ iface.security_zone.name }}
{%- endif %}
{%- if iface.description %}
set interface {{ iface_name }} comments "{{ iface.description }}"
{%- endif %}
{%- else %}
set interface {{ iface.name }} state on
{%- if iface.ip_address %}
set interface {{ iface.name }} {{ 'ipv6-address' if ':' in iface.ip_address.address else 'ipv4-address' }} {{ iface.ip_address.address | replace('/', ' mask-length ') }}
{%- endif %}
{%- if iface.security_zone %}
set interface {{ iface.name }} security-zone {{ iface.security_zone.name }}
{%- endif %}
{%- if iface.description %}
set interface {{ iface.name }} comments "{{ iface.description }}"
{%- endif %}
{%- endif %}
!
{%- endfor %}
{%- endif %}
{%- if static_routes %}
! --- Static Routes (return path to leaf per zone) ---
{%- for route in static_routes %}
set static-route {{ route.destination }} nexthop gateway address {{ route.nexthop }} on
{%- endfor %}
!
{%- endif %}
{%- if zone_policies %}{{ security_policies(zone_policies) }}
{%- endif %}
{%- if contexts %}
!
! --- Firewall Contexts (VSX Virtual Systems) — one per tenant, per ManagedFirewallContext ---
!
{%- for context in contexts %}
add virtual-system name {{ context.name }}
{%- if context.tenant_name %}
set virtual-system {{ context.name }} comments "{{ context.tenant_name }}"
{%- endif %}
{#- Transit legs: one VLAN interface per VRF (security zone) in the virtual
    system, whose own routing table holds the routes. Each member keeps its
    own address; the cluster VIP (below, in ClusterXL) is the gateway. #}
{%- if context.legs %}
{%- for leg in context.legs %}
{%- set leg_name = leg.parent_interface.name + '.' + leg.vlan | string %}
set interface {{ leg_name }} vlan {{ leg.vlan }}
set interface {{ leg_name }} state on
set interface {{ leg_name }} ipv4-address {{ leg.own_ip | replace('/', ' mask-length ') }}
set interface {{ leg_name }} security-zone {{ leg.zone }}
set virtual-system {{ context.name }} interface {{ leg_name }}
{%- endfor %}
set virtual-system {{ context.name }}
{%- for route in context.routes %}
set static-route {{ 'default' if route.destination == '0.0.0.0/0' else route.destination }} nexthop gateway address {{ route.nexthop }} on
{%- endfor %}
{%- elif context.vlan_id and context.parent_interface.name %}
{%- set ctx_iface_name = context.parent_interface.name + '.' + context.vlan_id | string %}
set interface {{ ctx_iface_name }} vlan {{ context.vlan_id }}
set interface {{ ctx_iface_name }} state on
{%- if context.ip_address %}
set interface {{ ctx_iface_name }} {{ 'ipv6-address' if ':' in context.ip_address else 'ipv4-address' }} {{ context.ip_address | replace('/', ' mask-length ') }}
{%- endif %}
set virtual-system {{ context.name }} interface {{ ctx_iface_name }}
{%- endif %}
{%- endfor %}
!
{%- for context in contexts if context.isolation %}
! --- PROD <-> NON-PROD isolation in virtual system {{ context.name }} ---
set virtual-system {{ context.name }}
{%- for deny in context.isolation %}
add access-rule layer "Network" position top name "deny-{{ deny.src_zone }}-to-{{ deny.dst_zone }}" action drop source {{ deny.src_zone }} destination {{ deny.dst_zone }} service Any track Log
{%- endfor %}
!
{%- endfor %}
{%- for context in contexts if context.policies %}
! --- Security Policies in virtual system {{ context.name }} ---
set virtual-system {{ context.name }}
{{- security_policies(context.policies) }}
{%- endfor %}
{%- endif %}
{%- if ha %}
!
! --- ClusterXL ---
set cluster member priority {{ ha.priority }}
set cluster mode {{ 'HighAvailability' if ha.mode == 'active-passive' else 'LoadSharing' }}
{%- if ha.ha_link %}
{%- if ha.unit %}
set interface {{ ha.ha_link }} ipv4-address {{ ha.link_addresses[ha.unit] | replace('/', ' mask-length ') }}
{%- endif %}
set cluster sync-interface {{ ha.ha_link }}
{%- endif %}
{#- ClusterXL: each member keeps its own interface address; the cluster
    virtual IP of a segment the pair terminates inline is its gateway,
    defined on the cluster object through the management API. -#}
{%- for context in contexts %}
{%- for leg in context.legs if leg.virtual_ip %}
{%- set leg_name = leg.parent_interface.name + '.' + leg.vlan | string %}
mgmt_cli set simple-cluster name "{{ ha.name }}" interfaces.add.1.name "{{ leg_name }}" interfaces.add.1.interface-type "cluster" interfaces.add.1.ip-address "{{ leg.virtual_ip.split('/')[0] }}" interfaces.add.1.network-mask "{{ leg.virtual_ip.split('/')[1] | int | cidr_to_netmask }}"
{%- endfor %}
{%- endfor %}
{%- for iface in fw_interfaces if iface.virtual_ip %}
{%- set iface_name = (iface.parent_interface.name + '.' + iface.vlan_id | string) if (iface.vlan_id and iface.parent_interface) else iface.name %}
mgmt_cli set simple-cluster name "{{ ha.name }}" interfaces.add.1.name "{{ iface_name }}" interfaces.add.1.interface-type "cluster" interfaces.add.1.ip-address "{{ iface.virtual_ip.split('/')[0] }}" interfaces.add.1.network-mask "{{ iface.virtual_ip.split('/')[1] | int | cidr_to_netmask }}"
{%- endfor %}
!
{%- endif %}
