{#- Fortinet FortiOS — zone-based firewall configuration -#}
{#- An HA pair terminating a segment inline owns its gateway (virtual_ip): config
    sync gives both members that one interface address. -#}
{#- A VDOM's rules match on its one hairpin interface (intf); the root
    table's on the zones its interfaces belong to. -#}
{%- macro security_policies(policies, intf=none) %}
#
# --- Service Objects (unique protocol/port combinations referenced below) ---
config firewall service custom
{%- set seen_svcs = [] %}
{%- for policy in policies %}
{%- for rule in policy.rules %}
{%- if rule.raw_protocol in ('tcp', 'udp') and rule.port_start %}
{%- set svc_name = 'svc-' + rule.raw_protocol + '-' + rule.port_start | string + ('-' + rule.port_end | string if rule.port_end and rule.port_end != rule.port_start else '') %}
{%- if svc_name not in seen_svcs %}
{%- set _ = seen_svcs.append(svc_name) %}
    edit "{{ svc_name }}"
        set {{ rule.raw_protocol }}-portrange {{ rule.port_start }}{{ '-' + rule.port_end | string if rule.port_end and rule.port_end != rule.port_start else '' }}
    next
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endfor %}
end
#
# --- Security Policies ---
config firewall policy
{%- for policy in policies %}
{%- for rule in policy.rules %}
{%- if rule.raw_protocol in ('tcp', 'udp') and rule.port_start %}
{%- set svc_name = 'svc-' + rule.raw_protocol + '-' + rule.port_start | string + ('-' + rule.port_end | string if rule.port_end and rule.port_end != rule.port_start else '') %}
{%- else %}
{%- set svc_name = 'ALL' %}
{%- endif %}
    edit {{ rule.seq }}
        set name "{{ rule.name }}"
        set srcintf "{{ intf or rule.src_zone or 'any' }}"
        set dstintf "{{ intf or rule.dst_zone or 'any' }}"
        set srcaddr "{{ rule.src or 'all' }}"
        set dstaddr "{{ rule.dst or 'all' }}"
        set action {{ 'accept' if rule.action == 'permit' else 'deny' }}
        set schedule "always"
        set service "{{ svc_name }}"
{%- if rule.log %}
        set logtraffic all
{%- endif %}
{%- if rule.security_profile %}
        set utm-status enable
        set profile-type group
        set profile-group "{{ rule.security_profile }}"
{%- endif %}
{%- if rule.description %}
        set comments "{{ rule.description }}"
{%- endif %}
    next
{%- endfor %}
{%- endfor %}
end
{%- endmacro -%}
{#- One address object per CIDR a table references: a policy's srcaddr/dstaddr
    must name an existing object. -#}
{%- macro address_objects(cidrs, title) %}
{%- set v4 = [] %}{%- set v6 = [] %}
{%- for cidr in cidrs %}{%- set _ = (v6 if ':' in cidr else v4).append(cidr) %}{%- endfor %}
#
# --- Address Objects ({{ title }}) ---
{%- if v4 %}
config firewall address
{%- for cidr in v4 %}
    edit "{{ cidr }}"
        set subnet {{ cidr.split('/')[0] }} {{ cidr.split('/')[1] | int | cidr_to_netmask }}
    next
{%- endfor %}
end
{%- endif %}
{%- if v6 %}
config firewall address6
{%- for cidr in v6 %}
    edit "{{ cidr }}"
        set ip6 {{ cidr }}
    next
{%- endfor %}
end
{%- endif %}
{%- endmacro -%}
{%- macro rule_cidrs(policies, known=[]) -%}
{%- set found = [] %}
{%- for policy in policies %}{%- for rule in policy.rules %}{%- for cidr in (rule.src, rule.dst) %}
{%- if cidr and cidr not in known and cidr not in found %}{%- set _ = found.append(cidr) %}{%- endif %}
{%- endfor %}{%- endfor %}{%- endfor %}
{{- found | join(',') -}}
{%- endmacro -%}
config system global
    set hostname "{{ name }}"
end
{%- if fw_interfaces %}
#
# --- Interfaces ---
config system interface
{%- for iface in fw_interfaces %}
{%- if iface.vlan_id and iface.parent_interface %}
    edit "{{ iface.parent_interface.name }}.{{ iface.vlan_id }}"
        set type vlan
        set vlanid {{ iface.vlan_id }}
        set interface "{{ iface.parent_interface.name }}"
{%- else %}
    edit "{{ iface.name }}"
{%- endif %}
{%- if iface.ip_address %}
{%- if ':' in (iface.virtual_ip or iface.ip_address.address) %}
        set ip6-address {{ (iface.virtual_ip or iface.ip_address.address) }}
{%- else %}
        set ip {{ (iface.virtual_ip or iface.ip_address.address) }}
{%- endif %}
{%- endif %}
        set allowaccess ping https ssh
        set status up
{%- if iface.description %}
        set description "{{ iface.description }}"
{%- endif %}
{%- if iface.security_zone %}
        set alias "{{ iface.security_zone.name }}"
{%- endif %}
    next
{%- endfor %}
end
{#- The root table's srcintf/dstintf are zone names: each zone groups the
    interfaces bound to it. #}
{%- set zone_members = {} %}
{%- for iface in fw_interfaces if iface.security_zone %}
{%- set ifname = (iface.parent_interface.name + '.' + iface.vlan_id | string) if (iface.vlan_id and iface.parent_interface) else iface.name %}
{%- set _ = zone_members.setdefault(iface.security_zone.name, []).append(ifname) %}
{%- endfor %}
{%- if zone_members %}
#
# --- Zones ---
config system zone
{%- for zone_name, members in zone_members.items() %}
    edit "{{ zone_name }}"
        set interface {% for member in members %}"{{ member }}"{{ ' ' if not loop.last }}{% endfor %}
    next
{%- endfor %}
end
{%- endif %}
{%- endif %}
{%- set zone_cidrs = [] %}
{%- for zone in zones or [] %}{%- for cidr in zone.member_cidrs %}{%- if cidr not in zone_cidrs %}{%- set _ = zone_cidrs.append(cidr) %}{%- endif %}{%- endfor %}{%- endfor %}
{%- set root_rule_cidrs = rule_cidrs(zone_policies or [], zone_cidrs) %}
{%- set root_cidrs = zone_cidrs + (root_rule_cidrs.split(',') if root_rule_cidrs else []) %}
{%- if root_cidrs %}{{ address_objects(root_cidrs, 'zone members and policy endpoints') }}
{%- endif %}
{%- if static_routes %}
#
# --- Static Routes (return path to leaf per zone) ---
config router static
{%- for route in static_routes %}
    edit {{ loop.index }}
        set dst {{ route.destination }}
        set gateway {{ route.nexthop }}
        set device "{{ route.interface }}"
        set comment "Return path: {{ route.vrf }}"
    next
{%- endfor %}
end
{%- endif %}
{%- if zone_policies %}{{ security_policies(zone_policies) }}
{%- endif %}
{%- if contexts %}
#
# --- Firewall Contexts (VDOMs) — one per tenant, per ManagedFirewallContext ---
config system vdom
{%- for context in contexts %}
    edit "{{ context.name }}"
    next
{%- endfor %}
end
{#- Transit legs: one VLAN interface per VRF in the VDOM, which has its own
    routing table; the HA pair's VIP is the interface address (FGCP config
    sync gives both members it). #}
{%- for context in contexts %}
{%- if context.legs %}
config global
    config system interface
{%- for leg in context.legs %}
        edit "{{ leg.parent_interface.name }}.{{ leg.vlan }}"
            set type vlan
            set vlanid {{ leg.vlan }}
            set interface "{{ leg.parent_interface.name }}"
            set vdom "{{ context.name }}"
            set ip {{ leg.virtual_ip or leg.own_ip }}
            set allowaccess ping
            set status up
            set alias "{{ leg.zone }}"
        next
{%- endfor %}
    end
end
#
# --- Zones and routes in VDOM {{ context.name }} ---
config vdom
    edit "{{ context.name }}"
        config system zone
{%- for leg in context.legs %}
            edit "{{ leg.zone }}"
                set intrazone allow
                set interface "{{ leg.parent_interface.name }}.{{ leg.vlan }}"
            next
{%- endfor %}
        end
        config router static
{%- for route in context.routes %}
            edit {{ loop.index }}
                set dst {{ route.destination }}
                set gateway {{ route.nexthop }}
                set device "{{ route.interface }}"
            next
{%- endfor %}
        end
{%- if context.isolation %}
        config firewall policy
{%- for deny in context.isolation %}
            edit {{ 900000 + loop.index }}
                set name "deny-{{ deny.src_zone }}-to-{{ deny.dst_zone }}"
                set srcintf "{{ deny.src_zone }}"
                set dstintf "{{ deny.dst_zone }}"
                set srcaddr "all"
                set dstaddr "all"
                set action deny
                set schedule "always"
                set service "ALL"
                set logtraffic all
            next
{%- endfor %}
        end
{%- endif %}
    next
end
{%- elif context.vlan_id and context.parent_interface.name %}
config global
    config system interface
        edit "{{ context.parent_interface.name }}.{{ context.vlan_id }}"
            set type vlan
            set vlanid {{ context.vlan_id }}
            set interface "{{ context.parent_interface.name }}"
            set vdom "{{ context.name }}"
{%- if context.ip_address %}
{%- if ':' in context.ip_address %}
            set ip6-address {{ context.ip_address }}
{%- else %}
            set ip {{ context.ip_address }}
{%- endif %}
{%- endif %}
            set allowaccess ping https ssh
            set status up
{%- if context.tenant_name %}
            set description "{{ context.tenant_name }}"
{%- endif %}
        next
    end
end
{%- endif %}
{%- endfor %}
{%- for context in contexts if context.policies %}
{%- set ctx_cidrs = rule_cidrs(context.policies) %}
{%- set ctx_intf = (context.parent_interface.name + '.' + context.vlan_id | string) if (not context.legs and context.vlan_id and context.parent_interface.name) else none %}
#
# --- Security Policies in VDOM {{ context.name }} ---
config vdom
    edit "{{ context.name }}"
{%- if ctx_cidrs %}{{ address_objects(ctx_cidrs.split(','), 'VDOM ' + context.name) }}
{%- endif %}
{{- security_policies(context.policies, ctx_intf) }}
    next
end
{%- endfor %}
{%- endif %}
{%- if ha %}
#
# --- HA Configuration ---
config system ha
    set group-id {{ ha.group_id }}
    set mode {{ 'a-p' if ha.mode == 'active-passive' else 'a-a' }}
    set priority {{ ha.priority }}
    set override {{ 'enable' if ha.preempt else 'disable' }}
{%- if ha.ha_link %}
    set hbdev "{{ ha.ha_link }}" 50
{%- endif %}
end
#
{%- endif %}
