{#- Sonic JSON Spine Configuration - Using Jinja2 tojson filter for clean JSON -#}
{%- set device_metadata = {
  'localhost': {
    'hostname': hostname,
    'type': sonic_device_type | default('SpineRouter')
  }
} -%}
{%- if bgp %}
{%- set _ = device_metadata['localhost'].update({'bgp_asn': bgp[0].local_as.asn}) -%}
{%- endif %}

{%- set vlan_config = {} -%}
{%- set loopback_interfaces = {} -%}
{%- set physical_interfaces = {} -%}
{%- set interface_ips = {} -%}
{%- set vlan_interfaces = {} -%}
{%- set bgp_neighbors = {} -%}
{%- set bgp_globals = {'default': {}} -%}
{%- set bgp_peer_groups = {} -%}
{%- set bgp_globals_af = {} -%}
{%- set ospf_router = {} -%}
{%- include 'common/sonic_common.j2' %}

{%- set route_map = {} -%}
{%- set prefix_set = {} -%}
{%- set prefix_table = {} -%}
{%- set bgp_neighbor_af = {} -%}
{%- include 'common/sonic_bgp_policy.j2' %}
{%- set configdb = {
  'DEVICE_METADATA': device_metadata,
  'VLAN': vlan_config,
  'LOOPBACK_INTERFACE': loopback_interfaces,
  'INTERFACE': physical_interfaces,
  'INTERFACE_IP': interface_ips,
  'VLAN_INTERFACE': vlan_interfaces,
  'BGP_GLOBALS': bgp_globals,
  'BGP_GLOBALS_AF': bgp_globals_af,
  'BGP_PEER_GROUP': bgp_peer_groups,
  'BGP_NEIGHBOR': bgp_neighbors,
  'OSPF_ROUTER': ospf_router,
  'NTP_SERVER': {},
  'SYSLOG_SERVER': {}
} -%}
{#- Only a device with a filter to install carries these tables (U, common/sonic_bgp_policy.j2). -#}
{%- for table, entries in {'ROUTE_MAP': route_map, 'PREFIX_SET': prefix_set, 'PREFIX': prefix_table, 'BGP_NEIGHBOR_AF': bgp_neighbor_af}.items() if entries -%}
{%- set _ = configdb.update({table: entries}) -%}
{%- endfor %}

{{ configdb | tojson(indent=2) }}
