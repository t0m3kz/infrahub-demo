#- Citrix NetScaler ADC — load balancer configuration -#
set ns config -IPAddress {{ management_ip }} -netmask 255.255.255.0
set ns hostName {{ name }}
{%- set snip_interfaces = lb_interfaces | rejectattr('role', 'equalto', 'management') | list %}
{%- if snip_interfaces %}
#
# --- SNIPs (Subnet IPs) ---
{%- for iface in snip_interfaces %}
{#- In an HA pair the SNIP floats with the primary node: on a segment the pair
    terminates inline it is the segment gateway (virtual_ip). -#}
{%- set addr = iface.virtual_ip or iface.ip_address.address %}
add ns ip {{ addr.split('/')[0] }} {{ addr.split('/')[1] | int | cidr_to_netmask }} -type SNIP
{%- if iface.description %}
# {{ iface.name }}: {{ iface.description }}
{%- endif %}
{%- endfor %}
#
{%- endif %}
{%- if ha %}
#
# --- High Availability (HA Node Pair) ---
{#- The HA node is the peer's NSIP, its management address. #}
{%- if ha.peer_management_ip %}
add ha node 1 {{ ha.peer_management_ip }}
{%- else %}
# no HA node: the peer has no management address yet
{%- endif %}
#
{%- endif %}
{#- One admin partition per load-balancer context (no traffic domains): the
    leg VLAN, created and tagged in the default partition, is bound to it;
    inside it the SNIP (.4, floating with the HA primary, the source of the
    member traffic under the default USNIP mode) bound to that VLAN, the
    default route to the border anycast (.1), then monitors, a service group
    and a vserver per VIP. -#}
{%- for ctx in contexts %}
# --- LB context {{ ctx.name }} ({{ 'dedicated' if ctx.dedicated else 'shared' }}): admin partition {{ ctx.partition }}, VRF {{ ctx.vrf }} ---
# documented-not-lab-verified: admin partition per context with its VLAN bound, partition-local SNIP bound to the VLAN and route
# leg {{ ctx.leg.name }}: VLAN {{ ctx.leg.vlan }} (border VNI {{ ctx.leg.vni }}), gateway {{ ctx.leg.anycast }}; VIP range {{ ctx.vip_prefix }} routed to {{ ctx.leg.floating }}
add ns partition {{ ctx.partition }}
add vlan {{ ctx.leg.vlan }}
bind vlan {{ ctx.leg.vlan }} -ifnum {{ ctx.leg.parent_interface }} -tagged
bind ns partition {{ ctx.partition }} -vlan {{ ctx.leg.vlan }}
switch ns partition {{ ctx.partition }}
add ns ip {{ ctx.leg.floating }} {{ ctx.leg.prefixlen | cidr_to_netmask }} -type SNIP
bind vlan {{ ctx.leg.vlan }} -IPAddress {{ ctx.leg.floating }} {{ ctx.leg.prefixlen | cidr_to_netmask }}
add route 0.0.0.0 0.0.0.0 {{ ctx.leg.anycast }}
{%- for vip in ctx.vips %}
# {{ vip.description or vip.hostname }}
{%- for check in vip.health_checks %}
add lb monitor {{ check.name }} {{ check.type }}{% if check.path %} -httpRequest "GET {{ check.path }}" -respCode 200{% endif %}{% if check.tls %} -secure YES{% endif %} -interval {{ check.interval_s }} -resptimeout {{ check.timeout_ms }} -units4 MSEC -retries {{ check.fall }} -successRetries {{ check.rise }} -LRTM DISABLED
{%- endfor %}
add serviceGroup sg_{{ vip.name }} {{ vip.tokens.service_type }}
{%- for member in vip.members %}
bind serviceGroup sg_{{ vip.name }} {{ member }} {{ vip.port }}
{%- else %}
# no pool members yet: the vserver stays down
{%- endfor %}
{%- for check in vip.health_checks %}
bind serviceGroup sg_{{ vip.name }} -monitorName {{ check.name }}
{%- endfor %}
add lb vserver vs_{{ vip.name }} {{ vip.tokens.service_type }} {{ vip.address }} {{ vip.port }} -lbMethod {{ vip.tokens.method }} -persistenceType {{ vip.tokens.persist }}
bind lb vserver vs_{{ vip.name }} sg_{{ vip.name }}
{%- if vip.terminate_tls %}
bind ssl vserver vs_{{ vip.name }} -certkeyName {{ vip.ssl }}
{%- endif %}
{{ 'enable' if vip.enabled else 'disable' }} lb vserver vs_{{ vip.name }}
{%- endfor %}
switch ns partition default
#
{%- endfor %}
save ns config
