!
! {{ name }} Configuration
!
hostname {{ name }}
!
system routing tcam security-group-acl
!
feature ospf
feature bgp
feature interface-vlan
feature lacp
feature vpc
feature lldp
!
{%- include 'common/cisco_nxos_vpc.j2' %}
! VLANs
{%- for vlan in vlans %}
vlan {{ vlan.vlan_id }}
  name {{ vlan.name }}
{%- if vlan.isolation_mode == 'isolated' %}
  ! private-vlan type: isolated  (configure PVLAN or port-protection separately)
{%- endif %}
!
{%- endfor %}
!
{%- if acls %}
! Zero-Trust ACLs (one per segment VLAN — inbound on SVI)
!
{%- for acl in acls %}
ip access-list {{ acl.name }}
{%- for rule in acl.rules %}
{%- if rule.src_zone or rule.dst_zone %}
  remark Zone: {{ rule.src_zone or 'any' }} -> {{ rule.dst_zone or 'any' }}
{%- endif %}
{%- if rule.src_customer or rule.dst_customer %}
  remark Customer: {{ rule.src_customer or 'any' }}/{{ rule.src_environment or 'any' }} -> {{ rule.dst_customer or 'any' }}/{{ rule.dst_environment or 'any' }}
{%- endif %}
  {{ rule.seq }} {{ rule.action }} {{ rule.protocol }} {{ rule.src -}}
{%- if rule.src_port %} {{ rule.src_port }}{% endif %} {{ rule.dst -}}
{%- if rule.dst_port %} {{ rule.dst_port }}{% endif -%}
{%- if rule.established %} established{% endif -%}
{%- if rule.log %} log{% endif -%}
{%- if rule.name %} ! {{ rule.name }}{% endif %}
{%- endfor %}
!
{%- endfor %}
{%- endif %}
!
! Interfaces
{%- for interface in interfaces if interface.role != 'mlag-peer' %}
interface {{ interface.name }}
{%- if interface.status == 'active' %}
  no shutdown
{%- endif %}
{%- include 'common/cisco_nxos_interface_ip.j2' %}
{%- if interface.vlans %}
  switchport
  switchport mode access
  switchport access vlan {{ interface.vlans[0] }}
{%- if interface.access_isolation_mode == 'isolated' %}
  ! TODO: configure port-isolation group X (NX-OS port isolation requires interface-level group assignment)
{%- endif %}
{%- endif %}
{%- if interface.get('ospf') %}
  ip ospf area {{ interface.ospf.area }}
{%- endif %}
!
{%- endfor %}
!
! OSPF Configuration
{% include 'common/cisco_nxos_ospf.j2' %}
!
! BGP Configuration
{% include 'common/cisco_nxos_bgp.j2' %}
!
{%- include 'common/cisco_nxos_vxlan.j2' -%}
!
! Route-maps
route-map RM-CONN-2-BGP permit 10
  match interface {{ loopback_name }}
!
{%- if vxlan and vxlan.l3_vni_mappings %}
{#- Permit-all, deliberately unqualified: inside a tenant VRF everything that is
    directly connected (the anycast-gateway SVIs) is exactly what should become an
    EVPN type-5 route. Referenced from cisco_nxos_bgp.j2's per-VRF block. #}
route-map RM-VRF-DIRECT-2-EVPN permit 10
!
{%- endif %}
{%- include 'common/cisco_nxos_svi.j2' -%}
!
{%- if vrf_gateways %}
!
! VRF Default Routes — firewall gateway per namespace (Option A: FW as inter-VRF router)
!
{%- for vrf, nexthop in vrf_gateways.items() %}
ip route 0.0.0.0/0 {{ nexthop }} vrf {{ vrf }}
{%- endfor %}
!
{%- endif %}
{%- if vlans|selectattr('sgt')|list or sgt_rules %}
!
! CTS Security Group Tags — VXLAN GPO tier enforcement (VLAN-to-SGT mapping —
! scales to trunk ports carrying multiple segments, unlike per-port
! cts manual/policy-static which is single-valued)
! group_id is globally unique across Arista and Cisco fabrics
!
feature cts
!
{%- for vlan in vlans if vlan.sgt %}
! Segment: {{ vlan.name }} — tier: {{ vlan.sgt_name }}
cts role-based sgt-map vlan {{ vlan.vlan_id }} sgt {{ vlan.sgt }}
{%- endfor %}
!
! CTS role-based permissions (SecurityTagRule — coarse tier-to-tier)
{%- for rule in sgt_rules %}
cts role-based permissions from {{ rule.src_sgt }} to {{ rule.dst_sgt }} {{ rule.action }}
  ! {{ rule.src_name }} → {{ rule.dst_name }}
  ! Customer: {{ rule.src_customer or 'any' }}/{{ rule.src_environment or 'any' }}
{%- endfor %}
!
{%- endif %}
{%- if leaf_pbr_rules %}
!
! Leaf PBR — LB return path first, then permitted firewall bypass,
! otherwise redirect to the firewall when a context is present.
!
{%- for rule in leaf_pbr_rules %}
! Customer: {{ rule.customer_name or 'any' }}/{{ rule.environment or 'any' }}
{%- if rule.lb_nexthop %}
ip access-list LB-BACKEND-VLAN{{ rule.vlan_id }}
{%- for ip in rule.backend_ips %}
  permit ip host {{ ip }} any
{%- endfor %}
!
route-map RM-LEAF-PBR-VLAN{{ rule.vlan_id }} permit 10
  match ip address LB-BACKEND-VLAN{{ rule.vlan_id }}
  set ip next-hop {{ rule.lb_nexthop }}
!
{%- endif %}
{%- if rule.fw_nexthop %}
ip access-list PBR-BYPASS-VLAN{{ rule.vlan_id }}
{%- for prefix in rule.bypass_prefixes %}
  permit ip any {{ prefix }}
{%- endfor %}
  deny ip any any
!
route-map RM-LEAF-PBR-VLAN{{ rule.vlan_id }} permit 20
  match ip address PBR-BYPASS-VLAN{{ rule.vlan_id }}
!
route-map RM-LEAF-PBR-VLAN{{ rule.vlan_id }} permit 30
  set ip next-hop {{ rule.fw_nexthop }}
!
{%- endif %}
interface Vlan{{ rule.vlan_id }}
  ip policy route-map RM-LEAF-PBR-VLAN{{ rule.vlan_id }}
!
{%- endfor %}
{%- endif %}
{%- include 'common/cisco_nxos_management.j2' %}
!
! Management
line console
line vty
!
