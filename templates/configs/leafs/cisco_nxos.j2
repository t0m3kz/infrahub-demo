!
! {{ name }} Configuration
!
hostname {{ name }}
{%- if group_policy %}
! GPO first enablement, in this order: routing template, copy and flash resize out of band, feature security-group
! exec out of band: copy running-config startup-config
! exec out of band: system flash sda resize extended (module reload; 24 GB memory floor; back up bootflash, logflash and the running configuration first)
system routing template-security-groups
! documented-not-lab-verified: reload timing of the routing template (the guide ties the reload to the flash resize)
{%- endif %}
!
{%- if not nxos_border %}
!
{%- endif %}
feature ospf
feature bgp
{%- include 'common/cisco_nxos_feature_bfd.j2' %}
feature interface-vlan
feature lacp
feature vpc
feature lldp
{%- if leaf_pbr_rules %}
feature pbr
{%- endif %}
{%- if group_policy %}
feature security-group
{%- endif %}
!
{%- include 'common/cisco_nxos_vpc.j2' %}
! VLANs
{%- for vlan in vlans %}
vlan {{ vlan.vlan_id }}
  name {{ vlan.name }}
{%- if vlan.isolation_mode == 'isolated' and not nxos_border %}
  ! private-vlan type: isolated  (configure PVLAN or port-protection separately)
{%- endif %}
!
{%- endfor %}
!
{%- if acls %}
! Zero-Trust ACLs (one per segment VLAN — inbound on SVI)
!
{%- include 'common/ip_access_lists.j2' %}
{%- endif %}
{%- if not nxos_border %}
!
{%- endif %}
{%- include 'common/cisco_nxos_gpo.j2' %}
! Interfaces
{%- for interface in interfaces if interface.role != 'mlag-peer' %}
interface {{ interface.name }}
{%- if nxos_border and interface.display_description %}
  description {{ interface.display_description }}
{%- endif %}
{%- if nxos_border and interface.dot1q_vlan %}
  encapsulation dot1q {{ interface.dot1q_vlan }}
{%- endif %}
{%- if interface.status == 'active' %}
  no shutdown
{%- endif %}
{%- include 'common/cisco_nxos_interface_ip.j2' %}
{%- if interface.vlans or nxos_border %}
{%- include 'common/cisco_nxos_switchport.j2' %}
{%- if interface.mode != 'trunk' and interface.access_isolation_mode == 'isolated' %}
  ! TODO: configure port-isolation group X (NX-OS port isolation requires interface-level group assignment)
{%- endif %}
{%- endif %}
{%- if interface.get('ospf') %}
  ip ospf area {{ interface.ospf.area }}
{%- endif %}
{%- if nxos_border and interface.circuits %}
  ! Circuit: {{ interface.circuits[0].circuit_id }} ({{ interface.circuits[0].bandwidth }} Mbps)
  ! Provider: {{ interface.circuits[0].provider }}
  ! Side: {{ interface.circuits[0].side }}
{%- endif %}
{%- if nxos_border and interface.virtual_links %}
  ! Virtual Link: {{ interface.virtual_links[0].link_name }}
  ! Type: {{ interface.virtual_links[0].link_type }}
  ! Bandwidth: {{ interface.virtual_links[0].bandwidth }} Mbps
{%- if interface.virtual_links[0].encryption %}
  ! Encryption: Enabled
{%- endif %}
{%- if interface.virtual_links[0].cloud_resource_id %}
  ! Cloud Resource: {{ interface.virtual_links[0].cloud_resource_id }}
{%- endif %}
{%- endif %}
!
{%- endfor %}
!
! OSPF Configuration
{% include 'common/cisco_nxos_ospf.j2' %}
!
! BGP Configuration
{% include 'common/cisco_nxos_bgp.j2' %}
!
{%- include 'common/cisco_nxos_vxlan.j2' -%}
!
! Route-maps
route-map RM-CONN-2-BGP permit 10
  match interface {{ ([loopback_name] + (vxlan.multisite.advertise_interfaces if nxos_border and vxlan and vxlan.multisite else [])) | unique | join(' ') }}
!
{%- if vxlan and vxlan.l3_vni_mappings %}
{#- Permit-all, deliberately unqualified: inside a tenant VRF everything that is
    directly connected (the anycast-gateway SVIs) is exactly what should become an
    EVPN type-5 route. Referenced from cisco_nxos_bgp.j2's per-VRF block. #}
{%- if leaf_transit_prefixes and not nxos_border %}
! The firewall transit /29s this leaf holds locally for PBR are originated by the borders only
! documented-not-lab-verified: deny sequence keeps the leaf's connected transit /29 out of the type-5 table
{%- for prefix in leaf_transit_prefixes %}
ip prefix-list PL-XCHG-TRANSIT seq {{ loop.index * 10 }} permit {{ prefix }}
{%- endfor %}
route-map RM-VRF-DIRECT-2-EVPN deny 5
  match ip address prefix-list PL-XCHG-TRANSIT
{%- endif %}
route-map RM-VRF-DIRECT-2-EVPN permit 10
!
{%- endif %}
{%- if nxos_border %}
{%- include 'common/cisco_nxos_vrf_static.j2' %}
{%- endif %}
{%- include 'common/cisco_nxos_svi.j2' -%}
!
{%- if leaf_pbr_rules %}
!
! Leaf PBR — LB return path first, then permitted firewall bypass,
! otherwise redirect to the firewall when a context is present.
! TODO(lab): TCAM carving for PBR (ing-sup / ifacl region) is platform-dependent
!
{%- for rule in leaf_pbr_rules %}
! Customer: {{ rule.customer_name or 'any' }}/{{ rule.environment or 'any' }}
{%- if rule.fw_nexthop %}
{%- if rule.bypass_prefixes %}
ip access-list PBR-BYPASS-VLAN{{ rule.vlan_id }}
{%- for prefix in rule.bypass_prefixes %}
  permit ip any {{ prefix }}
{%- endfor %}
!
! documented: deny sequence = forward by normal route lookup (NX-OS PBR); documented-not-lab-verified for VXLAN-routed traffic
route-map RM-LEAF-PBR-VLAN{{ rule.vlan_id }} deny 20
  match ip address PBR-BYPASS-VLAN{{ rule.vlan_id }}
!
{%- endif %}
! documented-not-lab-verified: the next hop is the VIP of the local transit leg (connected anycast SVI, resolved over the L2VNI);
! PBR falls back to normal routing when it is unresolved (fail-open), tracking over VXLAN needs lab validation
route-map RM-LEAF-PBR-VLAN{{ rule.vlan_id }} permit 30
  set ip next-hop {{ rule.fw_nexthop }}
!
{%- endif %}
interface Vlan{{ rule.vlan_id }}
  ip policy route-map RM-LEAF-PBR-VLAN{{ rule.vlan_id }}
!
{%- endfor %}
{%- endif %}

!
! Management
line console
line vty
!
