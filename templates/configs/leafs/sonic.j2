{#- Sonic JSON Leaf Configuration - Using Jinja2 tojson filter for clean JSON -#}
{%- set device_metadata = {
  'localhost': {
    'hostname': hostname,
    'type': sonic_device_type | default('LeafRouter')
  }
} -%}
{%- if bgp %}
{%- set _ = device_metadata['localhost'].update({'bgp_asn': bgp[0].local_as.asn}) -%}
{%- endif %}

{%- set vlan_config = {} -%}
{%- set loopback_interfaces = {} -%}
{%- set physical_interfaces = {} -%}
{%- set interface_ips = {} -%}
{%- set vlan_interfaces = {} -%}
{%- set bgp_neighbors = {} -%}
{%- set bgp_globals = {'default': {}} -%}
{%- set bgp_peer_groups = {} -%}
{%- set bgp_globals_af = {} -%}
{%- set ospf_router = {} -%}
{%- set vlan_members = {} -%}
{%- include 'common/sonic_common.j2' %}

{%- set vxlan_tunnel = {} -%}
{%- set vxlan_tunnel_map = {} -%}
{%- set vrf_config = {} -%}
{%- set bgp_evpn_rt = {} -%}
{%- set evpn_nvo = {} -%}
{%- include 'common/sonic_vxlan.j2' %}

{%- set static_route_table = {} -%}
{%- set sag = {} -%}
{%- set route_map = {} -%}
{%- set prefix_set = {} -%}
{%- set prefix_table = {} -%}
{%- include 'common/sonic_tenant_l3.j2' %}

{%- set acl_table = {} -%}
{%- set acl_rule = {} -%}
{%- if not sonic_border %}
{%- include 'common/sonic_acl.j2' %}
{%- include 'common/sonic_pbr.j2' %}
{%- endif %}

{%- set configdb = {
  'DEVICE_METADATA': device_metadata,
  'VLAN': vlan_config,
  'LOOPBACK_INTERFACE': loopback_interfaces,
  'INTERFACE': physical_interfaces,
  'INTERFACE_IP': interface_ips,
  'VLAN_INTERFACE': vlan_interfaces,
  'BGP_GLOBALS': bgp_globals,
  'BGP_GLOBALS_AF': bgp_globals_af,
  'BGP_PEER_GROUP': bgp_peer_groups,
  'BGP_NEIGHBOR': bgp_neighbors,
  'OSPF_ROUTER': ospf_router,
  'VXLAN_TUNNEL': vxlan_tunnel,
  'VXLAN_TUNNEL_MAP': vxlan_tunnel_map,
  'VRF': vrf_config,
  'BGP_GLOBALS_EVPN_RT': bgp_evpn_rt,
  'EVPN_NVO': evpn_nvo,
  'STATIC_ROUTE': static_route_table,
  'NTP_SERVER': {},
  'SYSLOG_SERVER': {}
} -%}
{%- if not sonic_border -%}
{%- set _ = configdb.update({'ACL_TABLE': acl_table, 'ACL_RULE': acl_rule}) -%}
{%- endif -%}
{#- Only added when a host port carries a VLAN, so a leaf without one keeps its table set. -#}
{%- if vlan_members -%}
{%- set _ = configdb.update({'VLAN_MEMBER': vlan_members}) -%}
{%- endif %}
{#- Same for the tenant L3 tables of sonic_tenant_l3.j2: only a device with an
    anycast gateway or a route map to install carries them. -#}
{%- for table, entries in {'SAG': sag, 'ROUTE_MAP': route_map, 'PREFIX_SET': prefix_set, 'PREFIX': prefix_table}.items() if entries -%}
{%- set _ = configdb.update({table: entries}) -%}
{%- endfor %}
{#- Per-table merge: MC-LAG contributes VLAN/VLAN_MEMBER/VLAN_INTERFACE
    entries that must not replace the tables built above. #}
{%- for table, entries in (sonic_mlag | default({})).items() %}
{%- set _ = configdb.update({table: dict(configdb.get(table) or {}, **entries)}) %}
{%- endfor %}

{{ configdb | tojson(indent=2) }}
