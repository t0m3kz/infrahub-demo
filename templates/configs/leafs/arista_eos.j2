!
! Arista EOS Leaf VXLAN/EVPN Configuration
! Device: {{ hostname }}
! Generated for Arista EOS
!

hostname {{ hostname }}
{%- if vxlan and vxlan.enabled and vxlan.evpn and vxlan.evpn.enabled %}

! EVPN on EOS requires the multi-agent routing model (the legacy ribd model has
! no EVPN address-family at all). Changing it reloads the routing agents, so it
! must be present from the first push, not added later.
service routing protocols model multi-agent
{%- endif %}

! Configure spanning tree mode
spanning-tree mode mstp

! Configure VLAN 1
no spanning-tree vlan-id 4094

{%- include 'common/arista_eos_mlag.j2' %}

{#- VLAN Configuration -#}
{%- for vlan in vlans %}
vlan {{ vlan.vlan_id }}
   name {{ vlan.name or 'VLAN_' + vlan.vlan_id|string }}
{%- if vlan.isolation_mode == 'isolated' %}
   ! private-vlan type: isolated  (configure PVLAN or port-protection separately)
{%- endif %}
{% endfor %}

{#- IP Access-Lists (zero-trust per-segment ACLs) -#}
{%- if acls %}
!
! Zero-Trust ACLs (one per segment VLAN — inbound on SVI)
!
{%- for acl in acls %}
ip access-list {{ acl.name }}
{%- for rule in acl.rules %}
{%- if rule.src_zone or rule.dst_zone %}
   remark Zone: {{ rule.src_zone or 'any' }} -> {{ rule.dst_zone or 'any' }}
{%- endif %}
{%- if rule.src_customer or rule.dst_customer %}
   remark Customer: {{ rule.src_customer or 'any' }}/{{ rule.src_environment or 'any' }} -> {{ rule.dst_customer or 'any' }}/{{ rule.dst_environment or 'any' }}
{%- endif %}
   {{ rule.seq }} {{ rule.action }} {{ rule.protocol }} {{ rule.src -}}
{%- if rule.src_port %} {{ rule.src_port }}{% endif %} {{ rule.dst -}}
{%- if rule.dst_port %} {{ rule.dst_port }}{% endif -%}
{%- if rule.established %} established{% endif -%}
{%- if rule.log %} log{% endif -%}
{%- if rule.name %} ! {{ rule.name }}{% endif %}
{%- endfor %}
!
{%- endfor %}
{%- endif %}

{#- LAG / Port-Channel Interfaces -#}
{%- for interface in interfaces if interface.lag_id is defined and interface.role != 'mlag-peer' %}
interface Port-Channel{{ interface.lag_id }}
{%- if interface.description %}
   description {{ interface.description }}
{%- endif %}
{%- if interface.lacp_mode == 'static' %}
   ! static LAG (no LACP)
{%- endif %}
{%- if interface.mtu %}
   mtu {{ interface.mtu }}
{%- endif %}
{%- if interface.minimum_links and interface.minimum_links > 1 %}
   port-channel min-links {{ interface.minimum_links }}
{%- endif %}
{%- include 'common/arista_eos_interface_ip.j2' %}
   no shutdown
{% endfor %}

{#- Physical member interfaces — bind to their LAG -#}
{%- for lag in interfaces if lag.lag_id is defined and lag.member_interfaces is defined and lag.role != 'mlag-peer' %}
{%- for member_name in lag.member_interfaces %}
interface {{ member_name }}
   channel-group {{ lag.lag_id }} mode {{ lag.lacp_mode | default('active') }}
   no shutdown
{% endfor %}
{%- endfor %}

{#- All Interfaces (Loopback, Physical, Virtual) -#}
{%- for interface in interfaces if interface.role != 'mlag-peer' %}
interface {{ interface.name }}
{%- if interface.description %}
   description {{ interface.description }}
{%- endif %}
{%- include 'common/arista_eos_interface_ip.j2' %}
{%- if interface.mode == 'trunk' %}
   switchport mode trunk
   switchport trunk allowed vlan {{ interface.vlans|join(',') }}
{%- elif interface.vlans %}
   switchport access vlan {{ interface.vlans[0] }}
{%- if interface.access_isolation_mode == 'isolated' %}
   switchport protected
{%- endif %}
{%- endif %}
{%- if interface.get('ospf') %}
   ip ospf area {{ interface.ospf.area }}
{%- endif %}
   no shutdown
{% endfor %}

{%- if ospf %}
{%- from 'common/arista_eos_ospf.j2' import render_ospf %}
! Configure OSPF
{{ render_ospf(ospf, interfaces) }}
{%- endif %}

{%- if bgp %}
{%- from 'common/arista_eos_bgp.j2' import render_bgp %}
! Configure BGP
{{ render_bgp(bgp, loopback_name) }}
{%- endif %}

! Configure route-maps
route-map RM-CONN-2-BGP permit 10
   match interface {{ loopback_name }}
{%- if leaf_transit_prefixes %}
!
! The firewall transit /29s this leaf holds locally for PBR are originated by the borders only
! documented-not-lab-verified: a deny entry keeps the leaf's connected transit /29 out of the EVPN type-5 table
{%- for prefix in leaf_transit_prefixes %}
ip prefix-list PL-XCHG-TRANSIT seq {{ loop.index * 10 }} permit {{ prefix }}
{%- endfor %}
route-map RM-VRF-CONN-2-EVPN deny 5
   match ip address prefix-list PL-XCHG-TRANSIT
route-map RM-VRF-CONN-2-EVPN permit 10
{%- endif %}

{%- if vxlan and vxlan.enabled %}
!
! VXLAN Configuration with Microsegmentation (VRF-aware VNIs)
!
{%- if vxlan.microsegmentation and vxlan.microsegmentation.enabled %}
! Microsegmentation enabled: {{ vxlan.microsegmentation.vrf_count }} VRF(s) for tenant isolation
{%- endif %}
!
interface {{ vxlan.interface }}
{%- if vxlan.vtep.ipv4 %}
   vxlan source-interface {{ vxlan.vtep.source_interface }}
{%- endif %}
{%- if vxlan.vtep.udp_port != 4789 %}
   vxlan udp-port {{ vxlan.vtep.udp_port }}
{%- endif %}
{%- if vxlan.l2_vni_mappings %}
   !
   ! L2 VNI Mappings (VLAN segments)
{%- for mapping in vxlan.l2_vni_mappings %}
   vxlan vlan {{ mapping.vlan_id }} vni {{ mapping.vni }}
{%- endfor %}
{%- endif %}
{%- if vxlan.l3_vni_mappings %}
   !
   ! L3 VNI Mappings (VRF segments for microsegmentation)
{%- for mapping in vxlan.l3_vni_mappings %}
   vxlan vrf {{ mapping.vrf_name }} vni {{ mapping.l3_vni }}
{%- endfor %}
{%- endif %}
{%- if vxlan.flooding == "static" and vxlan.remote_vteps and vxlan.l2_vni_mappings %}
{%- for mapping in vxlan.l2_vni_mappings %}
   vxlan vlan {{ mapping.vlan_id }} flood vtep {{ vxlan.remote_vteps | join(' ') }}
{%- endfor %}
{%- endif %}
!
{%- if vxlan.l3_vni_mappings %}
!
! VRF Definitions (Microsegmentation)
!
{%- for mapping in vxlan.l3_vni_mappings %}
vrf instance {{ mapping.vrf_name }}
   description {{ mapping.description | default('Tenant VRF for microsegmentation') }}
   {%- if vxlan.evpn.rd_format %}
   rd {{ vxlan.evpn.rd_format | replace('{vni}', mapping.l3_vni | string) }}
   {%- endif %}
{#- A `vrf instance` on EOS starts with routing DISABLED. Without this the SVIs
    below come up, ARP resolves, and hosts inside one subnet talk — but nothing
    routes between subnets in the VRF and the L3 VNI never forwards, which looks
    like an EVPN problem and is not one. #}
!
ip routing vrf {{ mapping.vrf_name }}
!
{%- endfor %}
{%- endif %}
{%- if vxlan.vrf_loopbacks %}
!
! VRF Loopback Interfaces
!
{%- for loopback in vxlan.vrf_loopbacks %}
interface {{ loopback.name }}
   description VRF {{ loopback.vrf }} L3VNI {{ loopback.l3_vni }}
   vrf {{ loopback.vrf }}
{%- if loopback.ip %}
   ip address {{ loopback.ip }}/32
{%- endif %}
!
{%- endfor %}
{%- endif %}
{%- if vxlan.evpn and vxlan.evpn.enabled and bgp %}
!
! EVPN Configuration (L2 + L3 VNI)
!
{%- for bgp_config in bgp %}
router bgp {{ bgp_config.local_as.asn }}
{%- if vxlan.l2_vni_mappings %}
   !
   ! L2 EVPN (VLAN-based)
{%- for mapping in vxlan.l2_vni_mappings %}
   vlan {{ mapping.vlan_id }}
      {%- if vxlan.evpn.rd_format %}
      rd {{ vxlan.evpn.rd_format | replace('{vni}', mapping.vni | string) }}
      {%- endif %}
      {%- if mapping.route_target %}
      route-target both {{ mapping.route_target }}
      {%- endif %}
      redistribute learned
{%- if mapping.get('arp_suppression') %}
      arp proxy
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if vxlan.l3_vni_mappings %}
   !
   ! L3 EVPN (VRF-based for microsegmentation)
{%- for mapping in vxlan.l3_vni_mappings %}
   vrf {{ mapping.vrf_name }}
      {%- if vxlan.evpn.rd_format %}
      rd {{ vxlan.evpn.rd_format | replace('{vni}', mapping.l3_vni | string) }}
      {%- endif %}
      {%- if mapping.route_target %}
      route-target import evpn {{ mapping.route_target }}
      route-target export evpn {{ mapping.route_target }}
      {%- endif %}
      {%- for rt in mapping.import_route_targets | default([]) %}
      route-target import evpn {{ rt }}
      {%- endfor %}
      redistribute connected{% if leaf_transit_prefixes %} route-map RM-VRF-CONN-2-EVPN{% endif %}
{%- endfor %}
{%- endif %}
{% endfor %}
{%- endif %}
{%- if vxlan.anycast_gateway and vxlan.anycast_gateway.enabled %}
!
! Anycast Gateway Configuration
!
ip virtual-router mac-address {{ vxlan.anycast_gateway.mac }}
{%- for vlan in vlans %}
{%- if vlan.gateway_ip or vlan.gateway_ipv6 %}
interface Vlan{{ vlan.vlan_id }}
{%- if vlan.isolation_mode == 'isolated' %}
   ! Isolation Mode: ISOLATED — intra-segment host-to-host traffic blocked via port-isolation
{%- elif vlan.isolation_mode == 'microsegmented' %}
   ! Isolation Mode: MICROSEGMENTED — intra+inter segment rules enforced via SVI ACL (and firewall if present)
{%- endif %}
{%- if vlan.vrf %}
   vrf {{ vlan.vrf }}
{%- endif %}
{%- if vlan.gateway_ip %}
   ip address virtual {{ vlan.gateway_ip }}
{%- endif %}
{%- if vlan.gateway_ipv6 %}
   ipv6 address virtual {{ vlan.gateway_ipv6 }}
{%- endif %}
{%- if vlan.acl_name %}
   ip access-group {{ vlan.acl_name }} in
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endif %}

{%- if leaf_pbr_rules %}
!
! Leaf PBR — LB return path first, then permitted firewall bypass,
! otherwise redirect to the firewall when a context is present.
! documented-not-lab-verified: policy-map type pbr / class-map type pbr / service-policy type pbr
! documented-not-lab-verified: a class without a set action (bypass) forwards by the normal route lookup
! NOTE: EOS 'set nexthop' has no VRF option: the firewall next hop must be reachable in the SVI's own VRF
! documented-not-lab-verified: the next hop is the VIP of the local transit leg (connected virtual-router SVI over the L2VNI), no 'recursive' needed
! (an ACL used by PBR must not contain deny entries - the bypass ACL relies on the implicit end of the list)
!
{%- for rule in leaf_pbr_rules %}
! Customer: {{ rule.customer_name or 'any' }}/{{ rule.environment or 'any' }}
{%- if rule.lb_nexthop %}
ip access-list LB-BACKEND-VLAN{{ rule.vlan_id }}
{%- for ip in rule.backend_ips %}
   permit ip host {{ ip }} any
{%- endfor %}
!
class-map type pbr match-any CM-LB-BACKEND-VLAN{{ rule.vlan_id }}
   match ip access-group LB-BACKEND-VLAN{{ rule.vlan_id }}
!
{%- endif %}
{%- if rule.fw_nexthop %}
ip access-list PBR-BYPASS-VLAN{{ rule.vlan_id }}
{%- for prefix in rule.bypass_prefixes %}
   permit ip any {{ prefix }}
{%- endfor %}
!
class-map type pbr match-any CM-PBR-BYPASS-VLAN{{ rule.vlan_id }}
   match ip access-group PBR-BYPASS-VLAN{{ rule.vlan_id }}
!
ip access-list PBR-ALL-VLAN{{ rule.vlan_id }}
   permit ip any any
!
class-map type pbr match-any CM-PBR-ALL-VLAN{{ rule.vlan_id }}
   match ip access-group PBR-ALL-VLAN{{ rule.vlan_id }}
!
{%- endif %}
policy-map type pbr PM-LEAF-PBR-VLAN{{ rule.vlan_id }}
{%- if rule.lb_nexthop %}
   class CM-LB-BACKEND-VLAN{{ rule.vlan_id }}
      set nexthop {{ rule.lb_nexthop }}
{%- endif %}
{%- if rule.fw_nexthop %}
   class CM-PBR-BYPASS-VLAN{{ rule.vlan_id }}
   class CM-PBR-ALL-VLAN{{ rule.vlan_id }}
      set nexthop {{ rule.fw_nexthop }}
{%- endif %}
!
interface Vlan{{ rule.vlan_id }}
   service-policy type pbr input PM-LEAF-PBR-VLAN{{ rule.vlan_id }}
!
{%- endfor %}
{%- endif %}

{%- include 'common/arista_eos_management.j2' %}

! End of configuration
