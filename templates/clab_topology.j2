{% macro containerlab_endpoint(endpoint) -%}
{% set interface_name = endpoint.name.value %}
{% set containerlab_os = endpoint.device.node.platform.node.containerlab_os.value %}
{{ endpoint.device.node.name.value }}:{% if containerlab_os in ["sonic-vs", "sonic-vm"] %}eth{{ (interface_name | replace("Ethernet", "") | int) // 4 + 1 }}{% elif interface_name[:8] == "Ethernet" %}eth{{ interface_name | replace("Ethernet", "") }}{% else %}{{ interface_name }}{% endif %}
{%- endmacro %}
{% for topology_edge in data["TopologyDeployment"]["edges"] %}
{% set topology = topology_edge.node %}
---
name: {{ topology.name.value | tojson }}
prefix: ""

mgmt:
  network: {{ topology.name.value | lower() | tojson }}
  ipv4-subnet: "172.20.{{ loop.index0 }}.0/24"

{% if topology.devices.edges %}
topology:
  nodes:
{% for device_edge in topology.devices.edges %}
{% set device = device_edge.node %}
    {{ device.name.value | tojson }}:
      kind: {{ device.platform.node.containerlab_os.value | tojson }}
      image: {{ device.software_image.node.containerlab_image.value | tojson }}
{% endfor %}

  links:
{% for device_edge in topology.devices.edges %}
{% set device = device_edge.node %}
{% for interface_edge in device.interfaces.edges %}
{% set interface = interface_edge.node %}
{% if interface.cable and interface.cable.node.endpoints.edges | length == 2 %}
{% for endpoint_edge in interface.cable.node.endpoints.edges %}
{% set endpoint = endpoint_edge.node %}
{% if endpoint.device.node.name.value == device.name.value and endpoint.name.value == interface.name.value %}
{% for peer_edge in interface.cable.node.endpoints.edges %}
{% set peer = peer_edge.node %}
{% if peer.device.node.name.value != device.name.value %}
{% set local_key = endpoint.device.node.name.value ~ ":" ~ endpoint.name.value %}
{% set peer_key = peer.device.node.name.value ~ ":" ~ peer.name.value %}
{% if local_key < peer_key %}
    - endpoints: [{{ containerlab_endpoint(endpoint) | trim | tojson }}, {{ containerlab_endpoint(peer) | trim | tojson }}]
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
