{% macro changed_suffix(x) %}{% if x.changed %} (changed: {{ x.changed | join('; ') }}){% endif %}{% endmacro %}
{% macro link_line(l) %}
{{ l.family }} {{ l.name }}{% set facts = [l.link_type, l.provider, ("id " ~ l.cable_id) if l.cable_id else "", ("vrf " ~ l.vrf) if l.vrf else ""] | select | list %}{% if facts %} [{{ facts | join(", ") }}]{% endif %}{% if l.ends %}: {{ l.ends | join(" <-> ") }}{% endif %}{% if l.places %}; {{ l.places | join(" <-> ") }}{% endif %}{{ changed_suffix(l) }}
{% endmacro %}
{% macro rule_line(r) %}
{{ r.policy ~ " / " if r.policy else "" }}{{ r.name }}{% if r.index %} (#{{ r.index }}){% endif %}{% if r.action %}: {{ r.action }} {{ r.source }} -> {{ r.destination }} {{ r.service }}{% endif %}{% if not r.enabled %} [disabled]{% endif %}{{ changed_suffix(r) }}
{% endmacro %}
{% macro segment_line(s) %}
{{ s.name }}{% set facts = [s.owner, s.environment, s.ip_version, s.prefix, ("gateway " ~ s.gateway) if s.gateway else "", ("VNI " ~ s.vnis | join("/")) if s.vnis else "", ("vlan " ~ s.vlan_scope) if s.vlan_scope else "", ("stretch " ~ s.stretch_scope) if s.stretch_scope else "", "firewall terminated" if s.firewall_gateway else ""] | select | list %}{% if facts %}: {{ facts | join(", ") }}{% endif %}{% if s.footprints %}; footprints {{ s.footprints | join(", ") }}{% endif %}{{ changed_suffix(s) }}
{% endmacro %}
